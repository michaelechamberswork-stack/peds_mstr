theme universal-theme-2 (
    name: Universal Theme
    themeNumber: 42
    version: 1.0
    style {
        currentThemeStyle: @lts
    }
    javaScript {
        fileUrls: [
            #IMAGE_PREFIX#libraries/apex/#MIN_DIRECTORY#widget.apexTabs#MIN#.js?v=#APEX_VERSION#
            #IMAGE_PREFIX#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #IMAGE_PREFIX#libraries/apex/#MIN_DIRECTORY#widget.stickyTableHeader#MIN#.js?v=#APEX_VERSION#
            #IMAGE_PREFIX#libraries/apex/#MIN_DIRECTORY#tooltipManager#MIN#.js?v=#APEX_VERSION#
            #HAMMERJS_URL#
            #THEME_IMAGES#js/modernizr-custom#MIN#.js?v=#APEX_VERSION#
            #IMAGE_PREFIX#plugins/com.oracle.apex.carousel/1.0/com.oracle.apex.carousel#MIN#.js?v=#APEX_VERSION#
            #THEME_IMAGES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_IMAGES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @standard
        navigationBarList: @navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @top-navigation-menu
        navigationMenuListSide: @side-navigation-menu
        loginPage: @login
        errorPage: @login
        printerFriendlyPage: @standard
        breadcrumb: @breadcrumb
        button: @text
        defaultLabel: @optional
        optionalLabel: @optional
        requiredLabel: @required
        list: @links-list
        region: @standard
        classicReport: @standard
    }
    regionDefaults {
        breadcrumbs: @title-bar
        charts: @standard
        forms: @standard
        lists: @standard
        reports: @standard
        wizards: @standard
        interactiveReports: @interactive-report
    }
    dialogDefaults {
        dialogContentRegion: @blank-with-attributes
        dialogButtonRegion: @buttons-container
        dialogPage: @modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #IMAGE_PREFIX#themes/theme_42/1.0/
        identifier: UNIVERSAL_THEME
    }

    style lts (
        name: LTS
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_IMAGES#less/theme/Vita.less
            outputCssFileUrl: #THEME_DB_IMAGES#5590980988865531.css
            jsonConfig: "{\"customCSS\":\"\",\"vars\":{\"@g_Accent-BG\":\"#7e4099\"}}"
        }
    )

    style vista (
        name: Vista
        css {
            fileUrls: #THEME_IMAGES#css/Vista#MIN#.css?v=#APEX_VERSION#
        }
        themeRollerAttributes {
            readOnly: true
        }
    )

    style vita (
        name: Vita
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_IMAGES#less/theme/Vita.less
            outputCssFileUrl: #THEME_IMAGES#css/Vita#MIN#.css?v=#APEX_VERSION#
        }
    )

    style vita-slate (
        name: Vita - Slate
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_IMAGES#less/theme/Vita-Slate.less
            outputCssFileUrl: #THEME_IMAGES#css/Vita-Slate#MIN#.css?v=#APEX_VERSION#
            jsonConfig: "{\"customCSS\":\"\",\"vars\":{\"@g_Accent-BG\":\"#505f6d\",\"@g_Accent-OG\":\"#ececec\",\"@g_Body-Title-BG\":\"#dee1e4\",\"@l_Link-Base\":\"#337ac0\",\"@g_Body-BG\":\"#f5f5f5\"}}"
        }
    )

)

