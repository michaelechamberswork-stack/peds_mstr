plugin ltsTimeField (
    name: LTS Time Field
    staticId: COM.LIFE-TS.PLUGINS.TIME_FIELD
    type: item
    component {
        supports: pageItems
        standardAttributes: [
            visibleWidget
            standardFormElement
            sessionStateChangeable
            readOnlyAttr
            sourceAttrs
            formatMaskDateOnly
        ]
    }
    source {
        plsqlCode:
            ```plsql
            FUNCTION LTS_TIME_FIELD_RENDER(
                P_ITEM                IN APEX_PLUGIN.T_PAGE_ITEM,
                P_PLUGIN              IN APEX_PLUGIN.T_PLUGIN,
                P_VALUE               IN VARCHAR2,
                P_IS_READONLY         IN BOOLEAN,
                P_IS_PRINTER_FRIENDLY IN BOOLEAN
                ) RETURN APEX_PLUGIN.T_PAGE_ITEM_RENDER_RESULT
            AS
                v_return APEX_PLUGIN.T_PAGE_ITEM_RENDER_RESULT;
                v_page_item_name VARCHAR2(30);
                v_html VARCHAR(4000); 
                v_jquery VARCHAR(4000); 
                v_hour NUMBER DEFAULT -1;
                v_minute NUMBER DEFAULT -1;
                v_ampm VARCHAR2(2) DEFAULT 'ZZ';
                v_checked VARCHAR2(18);
                v_value DATE;
            BEGIN
                IF APEX_APPLICATION.G_DEBUG THEN
                    APEX_PLUGIN_UTIL.DEBUG_PAGE_ITEM(
                        p_plugin => p_plugin,
                        p_page_item => p_item,            
                        p_value => p_value,
                        p_is_readonly => p_is_readonly,
                        p_is_printer_friendly => p_is_printer_friendly);
                END IF;
                        
                IF p_is_readonly OR p_is_printer_friendly THEN
                    APEX_PLUGIN_UTIL.PRINT_HIDDEN_IF_READONLY(
                        p_item_name => p_item.name,
                        p_value => p_value,
                        p_is_readonly => p_is_readonly,
                        p_is_printer_friendly => p_is_printer_friendly);
                    APEX_PLUGIN_UTIL.PRINT_DISPLAY_ONLY(
                        p_item_name => p_item.name,
                        p_display_value => p_value,
                        p_show_line_breaks => FALSE,
                        p_escape => TRUE,
                        p_attributes => p_item.element_attributes);    
                ELSE
                    IF p_value IS NOT NULL THEN
                        v_value := TO_DATE(p_value, 'HH:MI AM');
                        v_hour := TO_NUMBER(TO_CHAR(v_value, 'HH'));
                        v_minute := TO_NUMBER(TO_CHAR(v_value, 'MI'));
                        v_ampm := TO_CHAR(v_value, 'AM');
                    END IF;
                    
                    v_page_item_name := APEX_PLUGIN.GET_INPUT_NAME_FOR_PAGE_ITEM(p_is_multi_value => FALSE);
                    
                    v_html := '<div id="%ID%_DIV">';
                    
                    v_html := v_html||'<input type="hidden" name="%NAME%" id="%ID%" value="%TIME%">';
            
                    v_html := v_html||'<select id="%ID%_HOUR" class="selectlist" size="1">';        
                    v_html := v_html||'<option value=""></option>';
                    FOR i IN 1..12
                    LOOP
                        v_html := v_html||'<option value="'||TO_CHAR(i, 'FM00')||'"';
            
                        IF i = v_hour THEN
                            v_html := v_html||' selected="selected"';
                        END IF;
            
                        v_html := v_html||'>'||TO_CHAR(i, 'FM00')||'</option>';
                    END LOOP;
                    v_html := v_html||'</select>';
            
                    v_html := v_html||':';
                    v_html := v_html||'<select id="%ID%_MINUTE" class="selectlist" size="1">';        
                    v_html := v_html||'<option value=""></option>';
                    FOR i IN 0..3
                    LOOP
                        v_html := v_html||'<option value="'||TO_CHAR(i * 15, 'FM00')||'"';
            
                        IF i * 15 = v_minute THEN
                            v_html := v_html||' selected="selected"';
                        END IF;
            
                        v_html := v_html||'>'||TO_CHAR(i * 15, 'FM00')||'</option>';
                    END LOOP;
                    v_html := v_html||'</select>';
            
                    v_html := v_html||'&nbsp;';
            
                    v_html := v_html||'<select id="%ID%_AMPM" class="selectlist" size="1">';        
                    v_html := v_html||'<option value=""></option>';
                    v_html := v_html||'<option value="AM"';
            
                    IF v_ampm = 'AM' THEN
                        v_html := v_html||' selected="selected"';
                    END IF;
            
                    v_html := v_html||'>AM</option>';
                    v_html := v_html||'<option value="PM"';
            
                    IF v_ampm = 'PM' THEN
                        v_html := v_html||' selected="selected"';
                    END IF;
            
                    v_html := v_html||'>PM</option>';
                    v_html := v_html||'</select>';
            
                    v_html := v_html||'<span id="%ID%_ERROR" class="t-Form-error"></span>';
                    v_html := v_html||'</div>';
            
            --        v_jquery := v_jquery||'$("#%ID%_DIV").on("change", "select", function(e){lts_time_field_update($("#%ID%"),$("#%ID%_HOUR"),$("#%ID%_MINUTE"),$("#%ID%_AMPM"),$("#%ID%_ERROR"));});';
                    v_jquery := v_jquery||'$("#%ID%_DIV").on("change", "select", function(e){';
                    v_jquery := v_jquery||'  lts_time_field_update($("#%ID%"),$("#%ID%_HOUR"),$("#%ID%_MINUTE"),$("#%ID%_AMPM"),$("#%ID%_ERROR"));';
                    v_jquery := v_jquery||'  $("#%ID%").trigger("change");';
                    v_jquery := v_jquery||'});';
            
                    v_html := REPLACE(v_html, '%ID%', p_item.name);
                    v_html := REPLACE(v_html, '%NAME%', v_page_item_name);
                    v_html := REPLACE(v_html, '%TIME%', TO_CHAR(v_value, 'HH:MI AM'));
                    v_jquery := REPLACE(v_jquery, '%ID%', p_item.name);
            
                    HTP.P(v_html);   
                    
                    APEX_JAVASCRIPT.ADD_ONLOAD_CODE(p_code => v_jquery);     
                END IF;
                
                RETURN v_return;
            END;
            
            
            ```
    }
    callbacks {
        apiInterface: function
        renderProcedureName: lts_time_field_render
    }
    advanced {
        substituteAttributeValues: true
    }
    javaScript {
        fileUrls: #PLUGIN_FILES#lts_time_field.js
    }
    information {
        version: 1.0
    }
)

