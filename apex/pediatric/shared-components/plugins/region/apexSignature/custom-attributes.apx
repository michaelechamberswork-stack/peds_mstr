customAttribute attribute_05 (
    apexlangName: backgroundColor
    attribute: 5
    name: Background Color
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    default {
        value: rgba(0,0,0,0)
    }
    help {
        helpText: Background color of signature area. Defaults to "rgba(0,0,0,0)"
    }
    examples {
        examples:
            ```
            rgba(0,0,0,0) - transparent black<br>
            rgb(255,255,255) - opaque white<br>
            #FFFFFF - white<br>
            red
            ```
    }
)

