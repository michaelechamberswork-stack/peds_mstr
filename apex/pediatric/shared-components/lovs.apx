lov students (
    name: STUDENTS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT UPPER(last_name||', '||first_name) d, id r
            FROM therapists
            WHERE INSTR(applications, :APP_ID) > 0
                AND therapist_level = 'Student'
            ORDER BY 1
            ```
    }
)

lov therapists (
    name: THERAPISTS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT UPPER(last_name||', '||first_name) d, id r
            FROM therapists
            WHERE INSTR(applications, :APP_ID) > 0
                AND therapist_level = 'Therapist'
            ORDER BY 1
            ```
    }
)

