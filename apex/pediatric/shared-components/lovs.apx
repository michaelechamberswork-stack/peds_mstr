lov activity (
    name: ACTIVITY
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT entry d, NVL(value, entry) r
            FROM drop_down_table_entries
            WHERE type = 'Activity'
            ORDER BY order_by
            ```
    }
)

lov app-mode (
    name: APP_MODE
    source {
        location: staticValues
    }

    entry a (
        sequence: 2
        display: Admin
        return: A
    )

    entry t (
        sequence: 1
        display: Therapist
        return: T
    )

)

lov applications (
    name: APPLICATIONS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT d, r
            FROM
            (
                SELECT app_name d, TO_CHAR(app_id, 'FM000') r
                FROM applications
                UNION
                SELECT app_name||' Admin' d, TO_CHAR(app_id, 'FM000')||'A' r
                FROM applications
            )
            ORDER BY UPPER(d)
            ```
    }
)

lov location (
    name: LOCATION
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT entry d, NVL(value, entry) r
            FROM drop_down_table_entries
            WHERE type = 'Location'
            ORDER BY order_by
            ```
    }
)

lov location-therapist (
    name: LOCATION_THERAPIST
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT d, r
            FROM
            (
                SELECT d, NVL(r, rownum) r, NVL(order_by, rownum) order_by
                FROM
                (
                    SELECT d, r, order_by
                    FROM
                    (
                        SELECT entry d, NVL(value, entry) r, order_by
                        FROM drop_down_table_entries
                        WHERE type = 'Location'
            
                        UNION
            
                        SELECT location_other, NULL, NULL
                        FROM case_folder
                        WHERE therapist_id = :APP_USER_ID
                            AND location_other IS NOT NULL
                        GROUP BY location_other
                    )
                    ORDER BY order_by, UPPER(d)
                )
            )
            ORDER BY UPPER(d)
            ```
    }
)

lov program (
    name: PROGRAM
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT name d, p_id r
            FROM programs
            ORDER BY UPPER(name)
            ```
    }
)

lov read-only-list (
    name: READ_ONLY_LIST
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT UPPER(last_name||', '||first_name) d, id r
            FROM therapists
            WHERE INSTR(applications, :APP_ID) > 0
            ORDER BY 1
            ```
    }
)

lov report-rows-per-page (
    name: REPORT ROWS PER PAGE
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 10
        display: 10
        return: 10
    )

    entry lov_data-10 (
        sequence: 100
        display: 5000
        return: 5000
    )

    entry lov_data-2 (
        sequence: 20
        display: 15
        return: 15
