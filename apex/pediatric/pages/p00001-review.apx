    process create-session-review-entries (
        name: Create Session Review Entries
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                INSERT INTO session_review(sr_date, case_number)
                SELECT DISTINCT TRUNC(date_session, 'MM'), case_number
                FROM sessions
                WHERE case_number = :CURRENT_CLIENT
                    AND TRUNC(date_session, 'MM') NOT IN
                    (
                        SELECT sr_date
                        FROM session_review
                        WHERE case_number = :CURRENT_CLIENT
                    );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2470850141835852
        }
    )

    process remove-extra-characters-from-hash (
        name: Remove Extra Characters from Hash
        type: executeCode
        source {
            plsqlCode: :P1_HASH := REPLACE(REPLACE(:P1_HASH, CHR(10)), CHR(13));
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1842182891032720
        }
    )

)

