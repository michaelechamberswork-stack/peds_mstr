        execution {
            sequence: 130
        }
        when {
            event: click
            selectionType: button
            button: @save-signature
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    setCanvasBackgroundWhite();
                    $("#SIG_SAVE").click();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
