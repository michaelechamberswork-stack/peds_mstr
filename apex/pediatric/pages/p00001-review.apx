    dynamicAction delete-signature (
        name: Delete Signature
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: DeleteSignature
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: remove_reviewer_signature;
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @sessions
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sessions
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.data;
            }
            affectedElements {
                selectionType: items
                items: P1_DEL_SIGNATURE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
