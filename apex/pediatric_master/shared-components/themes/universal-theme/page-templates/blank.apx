pageTemplate blank (
    name: Blank
    templateClass: custom1
    templateOptions {
        default: t-PageBody--contain
    }
    page {
        header:
            ```html
            <!DOCTYPE html>
            <html class="no-js #RTL_CLASS# page-&APP_PAGE_ID!ATTR. app-&APP_ALIAS!ATTR." lang="&BROWSER_LANGUAGE!ATTR." #TEXT_DIRECTION#>
            <head>
              <meta charset="utf-8">
              <title>#TITLE#</title>
              #APEX_CSS#
              #THEME_CSS#
              #TEMPLATE_CSS#
              #THEME_STYLE_CSS#
              #APPLICATION_CSS#
              #PAGE_CSS#
              #FAVICONS#
              #HEAD#
              <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
              <meta name="app-version" content="&APP_VERSION!ATTR." />
              <meta name="app-tenant-id" content="&APP_TENANT_ID!ATTR." />
              <meta name="app-alias" content="&APP_ALIAS!ATTR." />
              <meta name="app-page-alias" content="&APP_PAGE_ALIAS!ATTR." />
            </head>
            <body class="t-PageBody t-PageBody--hideLeft t-PageBody--hideActions t-PageBody--blank no-anim #PAGE_CSS_CLASSES#" #TEXT_DIRECTION# #ONLOAD# id="t_PageBody">
            <noscript class="t-PageBody-noScript">&APP_TEXT$APEX_PAGE_NOSCRIPT.</noscript>
            <a href="#main" id="t_Body_skipToContent">&APP_TEXT$UI_PAGE_SKIP_TO_CONTENT.</a>
            #FORM_OPEN#
            
            ```
        body:
            ```html
            <main id="main" class="t-Body-contentInner">
              #SUCCESS_MESSAGE##NOTIFICATION_MESSAGE##GLOBAL_NOTIFICATION#
              #BODY#
            </main>
            <div class="t-Body-inlineDialogs" id="t_Body_inlineDialogs">#REGION_POSITION_04#</div>
            
            ```
        footer:
            ```html
            #FORM_CLOSE#
            #DEVELOPER_TOOLBAR#
            #APEX_JAVASCRIPT#
            #GENERATED_CSS#
            #THEME_JAVASCRIPT#
            #TEMPLATE_JAVASCRIPT#
            #APPLICATION_JAVASCRIPT#
            #PAGE_JAVASCRIPT#
            #GENERATED_JAVASCRIPT#
            </body>
            </html>
            ```
    }
    javaScript {
        executeWhenPageLoads: apex.theme42.initializePage.noSideCol();
    }
    subtemplate {
        successMessage:
            ```html
            <div class="t-Body-alert">
              <div class="t-Alert t-Alert--defaultIcons t-Alert--success t-Alert--horizontal t-Alert--page t-Alert--colorBG" id="t_Alert_Success" role="region" aria-labelledby="page_success_id">
                <div class="t-Alert-wrap">
                  <div class="t-Alert-icon">
                    <span class="t-Icon" role="img" aria-label="&"APP_TEXT$APEX.SUCCESS"!ATTR."></span>
                  </div>
                  <div class="t-Alert-content">
                    <div class="t-Alert-header">
                      <h2 id="page_success_id" class="u-vh">#SUCCESS_MESSAGE_HEADING#</h2>
                    </div>
                     <div class="t-Alert-title" role="alert">#SUCCESS_MESSAGE#</div>
                  </div>
                  <div class="t-Alert-buttons">
                    <button class="t-Button t-Button--noUI t-Button--icon t-Button--closeAlert" type="button" aria-label="#CLOSE_NOTIFICATION#" title="#CLOSE_NOTIFICATION#"><span class="t-Icon icon-close"></span></button>
                  </div>
                </div>
              </div>
            </div>
            ```
        notification:
            ```html
            <div class="t-Body-alert">
              <div class="t-Alert t-Alert--defaultIcons t-Alert--warning t-Alert--horizontal t-Alert--page t-Alert--colorBG" id="t_Alert_Notification" role="region" aria-labelledby="page_warning_id">
                <div class="t-Alert-wrap">
                  <div class="t-Alert-icon">
                    <span class="t-Icon" role="img" aria-label="&"APP_TEXT$WARNING"!ATTR."></span>
                  </div>
                  <div class="t-Alert-content">
                    <div class="t-Alert-header">
                      <h2 id="page_warning_id" class="u-vh">#ERROR_MESSAGE_HEADING#</h2>
                    </div>
                    <div class="t-Alert-body" role="alert">#MESSAGE#</div>
                  </div>
                  <div class="t-Alert-buttons">
                    <button class="t-Button t-Button--noUI t-Button--icon t-Button--closeAlert" type="button" aria-label="#CLOSE_NOTIFICATION#" title="#CLOSE_NOTIFICATION#"><span class="t-Icon icon-close"></span></button>
                  </div>
                </div>
              </div>
            </div>
            ```
    }
    layout {
        maxColumns: 12
        alwaysUseMaxColumns: true
        alwaysRenderLayout: false
        defaultLabelColumnSpan: 2
        firstColumnAttributes: col-start
        lastColumnAttributes: col-end
        containerTemplate:
            ```html
            <div class="container">
            #ROWS#
            </div>
            ```
        rowTemplate:
            ```html
            <div class="row #CSS_CLASSES#">
            #COLUMNS#
            </div>
            ```
        columnTemplate: <div class="col col-#COLUMN_SPAN_NUMBER# #CSS_CLASSES# #FIRST_LAST_COLUMN_ATTRIBUTES#" #ATTRIBUTES#>#CONTENT#</div>
    }
    positions {
        breadcrumbPosition: body
        sidebarPosition: body
    }
    errorPage {
        template:
            ```html
            <div class="t-Alert t-Alert--danger t-Alert--wizard t-Alert--defaultIcons">
              <div class="t-Alert-wrap">
                <div class="t-Alert-icon">
                  <span class="t-Icon" role="img" aria-label="&"APP_TEXT$WARNING"!ATTR."></span>
                </div>
                <div class="t-Alert-content">
                  <div class="t-Alert-body">
                    <h1 class="t-Alert-errorTitle">#MESSAGE#</h1>
                    <p>#ADDITIONAL_INFO#</p>
                    <div class="t-Alert-inset">#TECHNICAL_INFO#</div>
                  </div>
                </div>
                <div class="t-Alert-buttons">
                  <button class="a-Error-back t-Button t-Button--hot w50p t-Button--large" type="button">#OK#</button>
                </div>
              </div>
            </div>
            ```
    }

    templateOption contain-body-content (
        name: Contain Body Content
        sequence: 1
        appearance {
            cssClasses: t-PageBody--contain
        }
        help {
            helpText: The contents of the page will be contained to the max-width value set in Theme Roller.
        }
    )

    slot body (
        name: Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
        gridLayout {
            maxFixedColumns: 12
        }
    )

    slot dialogsDrawersAndPopups (
        name: Dialogs, Drawers and Popups
        staticId: REGION_POSITION_04
        gridLayout {
            maxFixedColumns: 12
        }
    )

)

