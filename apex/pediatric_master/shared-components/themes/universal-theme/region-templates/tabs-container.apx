regionTemplate tabs-container (
    name: Tabs Container
    templateClass: navigationRegion
    templateOptions {
        preset: t-TabsRegion-mod--simple
    }
    region {
        template:
            ```html
            <div class="t-TabsRegion #REGION_CSS_CLASSES# apex-tabs-region" #REGION_LANDMARK_ATTRIBUTES# #REGION_ATTRIBUTES# id="#DOM_ID#" data-tabs-label="#TITLE!ATTR#">
              #BODY#
              <div class="t-TabsRegion-items">#SUB_REGIONS#</div>
            </div>
            ```
    }
    subRegions {
        template: <div data-label="#SUB_REGION_TITLE!ATTR#" id="SR_#SUB_REGION_ID#">#SUB_REGION#</div>
    }
    javaScript {
        fileUrls: #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.apexTabs#MIN#.js?v=#APEX_VERSION#
    }

    templateOption remember-active-tab (
        name: Remember Active Tab
        sequence: 10
        appearance {
            cssClasses: js-useLocalStorage
        }
    )

    templateOption fill-tab-labels (
        name: Fill Tab Labels
        group: @region/layout-2
        sequence: 10
        appearance {
            cssClasses: t-TabsRegion-mod--fillLabels
        }
    )

    templateOption pill (
        name: Pill
        group: @region/tab-style
        sequence: 20
        appearance {
            cssClasses: t-TabsRegion-mod--pill
        }
    )

    templateOption simple (
        name: Simple
        group: @region/tab-style
        sequence: 10
        appearance {
            cssClasses: t-TabsRegion-mod--simple
        }
    )

    templateOption above-label (
        name: Above Label
        group: @region/tabs-icon
        sequence: 10
        appearance {
            cssClasses: t-Tabs--iconsAbove
        }
    )

    templateOption inline-with-label (
        name: Inline with Label
        group: @region/tabs-icon
        sequence: 20
        appearance {
            cssClasses: t-Tabs--inlineIcons
        }
    )

    templateOption tabs-small (
        name: Small
        group: @region/tabs-size
        sequence: 10
        appearance {
            cssClasses: t-TabsRegion-mod--small
        }
    )

    templateOption tabslarge (
        name: Large
        group: @region/tabs-size
        sequence: 20
        appearance {
            cssClasses: t-TabsRegion-mod--large
        }
    )

    slot regionBody (
        name: Region Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
    )

    slot tabs (
        name: Tabs
        staticId: SUB_REGIONS
        gridLayout {
            gridSupport: false
        }
    )

)

