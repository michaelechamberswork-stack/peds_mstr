regionTemplate interactive-report (
    name: Interactive Report
    templateClass: reportsRegion
    templateOptions {
        preset: t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
    }
    region {
        template:
            ```html
            <div id="#DOM_ID#" #REGION_LANDMARK_ATTRIBUTES# #REGION_ATTRIBUTES# class="t-IRR-region #REGION_CSS_CLASSES#">
              <h2 class="t-IRR-title" id="#DOM_ID#_heading" data-apex-heading>#TITLE#</h2>
                <div class="t-Region-orderBy">#ORDER_BY_ITEM#</div>
                #PREVIOUS#
                #BODY#
                #SUB_REGIONS#
                #NEXT#
            </div>
            
            
            ```
    }
    accessibility {
        landmarkType: region
    }

    templateOption removeborders (
        name: Remove Borders
        sequence: 10
        appearance {
            cssClasses: t-IRR-region--noBorders
        }
        help {
            helpText: Removes borders around the Interactive Report
        }
    )

    templateOption show-maximize-button (
        name: Show Maximize Button
        sequence: 20
        appearance {
            cssClasses: js-showMaximizeButton
        }
        help {
            helpText: Displays a button in the Interactive Reports toolbar to maximize the report. Clicking this button will toggle the maximize state and stretch the report to fill the screen.
        }
    )

    templateOption hiddenheadernoat (
        name: Hidden
        group: @region/header-visibility
        sequence: 1
        appearance {
            cssClasses: [
                t-IRR-region--removeHeader
                js-removeLandmark
            ]
        }
    )

    templateOption hideregionheader (
        name: Hidden but accessible
        group: @region/header-visibility
        sequence: 1
        appearance {
            cssClasses: [
                t-IRR-region--hideHeader
                js-addHiddenHeadingRoleDesc
            ]
        }
        help {
            helpText: This option will hide the region header. Note that the region title will still be audible for Screen Readers.
        }
    )

    slot next (
        name: Next
        staticId: NEXT
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot previous (
        name: Previous
        staticId: PREVIOUS
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot regionBody (
        name: Region Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
    )

    slot sortOrder (
        name: Sort Order
        staticId: ORDER_BY_ITEM
        supports {
            regions: false
            items: true
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot subRegions (
        name: Sub Regions
        staticId: SUB_REGIONS
    )

)

