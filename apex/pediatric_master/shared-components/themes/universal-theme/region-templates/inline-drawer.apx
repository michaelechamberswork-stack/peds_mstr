regionTemplate inline-drawer (
    name: Inline Drawer
    templateClass: custom4
    templateOptions {
        preset: js-dialog-class-t-Drawer--pullOutEnd
        default: js-modal
    }
    region {
        template:
            ```html
            <div id="#DOM_ID#_parent">
              <div id="#DOM_ID#" class="t-DrawerRegion js-dialog-class-ui-dialog--drawer #REGION_CSS_CLASSES# js-regionDialog js-hidden" #REGION_LANDMARK_ATTRIBUTES# #REGION_ATTRIBUTES# title="#TITLE!ATTR#">
                <div class="t-DrawerRegion-wrap">
                  <div class="t-DrawerRegion-bodyWrapperOut">
                    <div class="t-DrawerRegion-bodyWrapperIn">
                      <div class="t-DrawerRegion-body">#BODY##SUB_REGIONS#</div>
                    </div>
                  </div>
                  <div class="t-DrawerRegion-buttons">
                    <div class="t-ButtonRegion t-ButtonRegion--dialogRegion">
                      <div class="t-ButtonRegion-wrap">
                        <div class="t-ButtonRegion-col t-ButtonRegion-col--left">
                          <div class="t-ButtonRegion-buttons">#PREVIOUS##DELETE##CLOSE#</div>
                        </div>
                        <div class="t-ButtonRegion-col t-ButtonRegion-col--right">
                          <div class="t-ButtonRegion-buttons">#EDIT##CREATE##NEXT#</div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="t-DrawerRegion-footer">#FOOTER#</div>
                </div>
              </div>
            </div>
            ```
    }

    templateOption modal (
        name: Modal
        sequence: 10
        appearance {
            cssClasses: js-modal
        }
    )

    templateOption remove-body-padding (
        name: Remove Body Padding
        sequence: 5
        appearance {
            cssClasses: t-DialogRegion--noPadding
        }
        help {
            helpText: Removes the padding around the region body.
        }
    )

    templateOption drawer-size-extra-large (
        name: Extra Large
        group: @region/dialog-size-2
        sequence: 40
        appearance {
            cssClasses: js-dialog-class-t-Drawer--xl
        }
    )

    templateOption drawer-size-large (
        name: Large
        group: @region/dialog-size-2
        sequence: 30
        appearance {
            cssClasses: js-dialog-class-t-Drawer--lg
        }
    )

    templateOption drawer-size-medium (
        name: Medium
        group: @region/dialog-size-2
        sequence: 20
        appearance {
            cssClasses: js-dialog-class-t-Drawer--md
        }
    )

    templateOption drawer-size-small (
        name: Small
        group: @region/dialog-size-2
        sequence: 10
        appearance {
            cssClasses: js-dialog-class-t-Drawer--sm
        }
    )

    templateOption none (
        name: None (Auto)
        group: @region/dialog-size-2
        sequence: 5
        appearance {
            cssClasses: js-dialog-nosize
        }
    )

    templateOption position-bottom (
        name: Bottom
        group: @region/region-position
        sequence: 40
        appearance {
            cssClasses: js-dialog-class-t-Drawer--pullOutBottom
        }
    )

    templateOption position-end (
        name: End
        group: @region/region-position
        sequence: 20
        appearance {
            cssClasses: js-dialog-class-t-Drawer--pullOutEnd
        }
    )

    templateOption position-start (
        name: Start
        group: @region/region-position
        sequence: 10
        appearance {
            cssClasses: js-dialog-class-t-Drawer--pullOutStart
        }
    )

    templateOption position-top (
        name: Top
        group: @region/region-position
        sequence: 30
        appearance {
            cssClasses: js-dialog-class-t-Drawer--pullOutTop
        }
    )

    slot close (
        name: Close
        staticId: CLOSE
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot create (
        name: Create
        staticId: CREATE
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot delete (
        name: Delete
        staticId: DELETE
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot drawerFooter (
        name: Drawer Footer
        staticId: FOOTER
        supports {
            items: true
            buttons: true
        }
    )

    slot edit (
        name: Edit
        staticId: EDIT
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot next (
        name: Next
        staticId: NEXT
        supports {
            regions: false
            items: true
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot previous (
        name: Previous
        staticId: PREVIOUS
        supports {
            regions: false
            items: true
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot regionBody (
        name: Drawer Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
    )

    slot subRegions (
        name: Sub Regions
        staticId: SUB_REGIONS
    )

)

