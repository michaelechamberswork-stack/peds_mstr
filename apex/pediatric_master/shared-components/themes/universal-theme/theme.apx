theme universal-theme (
    name: Universal Theme
    themeNumber: 142
    baseTheme: ut-26.1
    style {
        currentThemeStyle: @lts
    }
    javaScript {
        fileUrls: [
            #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #THEME_FILES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_FILES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @/standard
        navigationBarList: @/navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @/top-navigation-menu
        navigationMenuListSide: @/side-navigation-menu
        loginPage: @/login
        errorPage: @/login
        printerFriendlyPage: @/standard
        breadcrumb: @/breadcrumb
        button: @/text
        defaultLabel: @/optional
        optionalLabel: @/optional
        requiredLabel: @/required
        list: @/links-list
        region: @/standard
        classicReport: @/standard
        headerToolbar: @/alert
        footerToolbar: @/alert
    }
    regionDefaults {
        breadcrumbs: @/title-bar
        charts: @/standard
        forms: @/standard
        lists: @/standard
        reports: @/standard
        wizards: @/standard
        interactiveReports: @/interactive-report
    }
    dialogDefaults {
        dialogContentRegion: @/blank-with-attributes
        dialogButtonRegion: @/buttons-container
        dialogPage: @/modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #APEX_FILES#themes/theme_42/26.1/
        identifier: UNIVERSAL_THEME
    }

    style lts (
        name: LTS
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_IMAGES#less/theme/Vita.less
            outputCssFileUrl: #THEME_DB_FILES#55840199596767209.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Accent-BG\":\"#7e4099\",\"@g_Nav-BG\":\"#7e4099\",\"@g_Nav-Active-BG\":\"#522963\"},\"customCSS\":\".lts-no-wrap{\\n    white-space: nowrap;\\n}\\n\\n.apex-item-select, .apex-item-text, .apex-item-textarea, .apex-item-multi {\\n    backface-visibility: hidden;\\n}\\n\\n.lts-full-width{\\n    width: 100%;\\n}\",\"useCustomLess\":\"N\"}"
        }
    )

    style vista (
        name: Vista
        css {
            fileUrls: #THEME_IMAGES#css/Vista#MIN#.css?v=#APEX_VERSION#
        }
        themeRollerAttributes {
            readOnly: true
        }
        advanced {
            endUserCanPick: true
        }
    )

)

