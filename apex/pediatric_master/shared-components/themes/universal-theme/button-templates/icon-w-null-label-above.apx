buttonTemplate icon-w-null-label-above (
    name: Icon w/ NULL Label Above
    templateClass: buttonAlternative2
    button {
        normal:
            ```html
            <div class="col ">
                <div class="t-Form-fieldContainer t-Form-fieldContainer--stacked  ">
                    <div class="t-Form-labelContainer">
                        &nbsp;
                    </div>
                    <div class="t-Form-inputContainer">
                        <button class="t-Button t-Button--noLabel t-Button--icon #BUTTON_CSS_CLASSES#" #BUTTON_ATTRIBUTES# onclick="#JAVASCRIPT#" type="button" id="#BUTTON_ID#" title="#LABEL#" aria-label="#LABEL#">
                            <span class="t-Icon #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            </div>            
            
            ```
        hot:
            ```html
            <div class="col ">
                <div class="t-Form-fieldContainer t-Form-fieldContainer--stacked  ">
                    <div class="t-Form-labelContainer">
                        &nbsp;
                    </div>
                    <div class="t-Form-inputContainer">
                        <button class="t-Button t-Button--noLabel t-Button--icon #BUTTON_CSS_CLASSES# t-Button--hot" #BUTTON_ATTRIBUTES# onclick="#JAVASCRIPT#" type="button" id="#BUTTON_ID#" title="#LABEL#" aria-label="#LABEL#">
                            <span class="t-Icon #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            </div>            
                        
            ```
    }
    advanced {
        identifier: ICON_W/_NULL_LABEL_ABOVE
    }
)

