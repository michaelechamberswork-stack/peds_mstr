buttonTemplate text-with-icon (
    name: Text with Icon
    templateClass: buttonAlternative1
    templateOptions {
        preset: t-Button--iconLeft
    }
    button {
        normal: "<button class=\"t-Button t-Button--icon #BUTTON_CSS_CLASSES#\" {if MENU_ID/}data-menu=\"#MENU_ID#\"{endif/} #BUTTON_ATTRIBUTES# #ONCLICK# type=\"button\" id=\"#DOM_ID#\" data-otel-labeL=\"#BUTTON_NAME!ATTR#\" {if IS_DISABLED/} disabled{endif/}><span class=\"t-Icon t-Icon--left #ICON_CSS_CLASSES#\" aria-hidden=\"true\"></span><span class=\"t-Button-label\">#LABEL#</span><span class=\"t-Icon t-Icon--right #ICON_CSS_CLASSES#\" aria-hidden=\"true\"></span></button>"
        hot: "<button class=\"t-Button t-Button--icon #BUTTON_CSS_CLASSES# t-Button--hot\" {if MENU_ID/}data-menu=\"#MENU_ID#\"{endif/} #BUTTON_ATTRIBUTES# #ONCLICK# type=\"button\" id=\"#DOM_ID#\" data-otel-label=\"#BUTTON_NAME!ATTR#\" {if IS_DISABLED/} disabled{endif/}><span class=\"t-Icon t-Icon--left #ICON_CSS_CLASSES#\" aria-hidden=\"true\"></span><span class=\"t-Button-label\">#LABEL#</span><span class=\"t-Icon t-Icon--right #ICON_CSS_CLASSES#\" aria-hidden=\"true\"></span></button>"
    }

    templateOption hide-icon-on-desktop (
        name: Hide Icon on Desktop
        sequence: 20
        appearance {
            cssClasses: t-Button--desktopHideIcon
        }
        help {
            helpText: This template options hides the button icon on large screens.
        }
    )

    templateOption hide-label-on-mobile (
        name: Hide Label on Mobile
        sequence: 10
        appearance {
            cssClasses: t-Button--mobileHideLabel
        }
        help {
            helpText: This template options hides the button label on small screens.
        }
    )

    templateOption push (
        name: Push
        group: @button/icon-hover-animation
        sequence: 20
        appearance {
            cssClasses: t-Button--hoverIconPush
        }
        help {
            helpText: The icon will animate to the right or left on button hover or focus.
        }
    )

    templateOption spin (
        name: Spin
        group: @button/icon-hover-animation
        sequence: 10
        appearance {
            cssClasses: t-Button--hoverIconSpin
        }
        help {
            helpText: The icon will spin on button hover or focus.
        }
    )

    templateOption lefticon (
        name: Left
        group: @button/icon-position
        sequence: 10
        appearance {
            cssClasses: t-Button--iconLeft
        }
    )

    templateOption righticon (
        name: Right
        group: @button/icon-position
        sequence: 20
        appearance {
            cssClasses: t-Button--iconRight
        }
    )

)

