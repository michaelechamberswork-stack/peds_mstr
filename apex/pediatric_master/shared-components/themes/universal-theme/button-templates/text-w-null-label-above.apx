buttonTemplate text-w-null-label-above (
    name: Text w/ NULL Label Above
    templateClass: button
    button {
        normal:
            ```html
            <div class="col ">
                <div class="t-Form-fieldContainer t-Form-fieldContainer--stacked  ">
                    <div class="t-Form-labelContainer">
                        &nbsp;
                    </div>
                    <div class="t-Form-inputContainer">
                        <button onclick="#JAVASCRIPT#" class="t-Button #BUTTON_CSS_CLASSES#" type="button" #BUTTON_ATTRIBUTES# id="#BUTTON_ID#">
                            <span class="t-Button-label">
                                #LABEL#
                            </span>
                        </button>
                    </div>
                </div>
            </div>
            ```
        hot:
            ```html
            <div class="col ">
                <div class="t-Form-fieldContainer t-Form-fieldContainer--stacked  ">
                    <div class="t-Form-labelContainer">
                        &nbsp;
                    </div>
                    <div class="t-Form-inputContainer">
                        <button onclick="#JAVASCRIPT#" class="t-Button t-Button--hot #BUTTON_CSS_CLASSES#" type="button" #BUTTON_ATTRIBUTES# id="#BUTTON_ID#">
                            <span class="t-Button-label">
                                #LABEL#
                            </span>
                        </button>
                    </div>
                </div>
            </div>
            ```
    }
    advanced {
        identifier: TEXT_W/_NULL_LABEL_ABOVE
    }
)

