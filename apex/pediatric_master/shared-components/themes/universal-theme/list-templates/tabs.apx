listTemplate tabs (
    name: Tabs
    templateClass: tabbedNavigationList
    templateOptions {
        preset: t-Tabs--simple
    }
    list {
        beforeEntries: <ul class="t-Tabs #COMPONENT_CSS_CLASSES#">
        afterEntries: </ul>
    }
    entry {
        current:
            ```html
            <li class="t-Tabs-item is-active #A03#" aria-current="page" id="#A01#">
              <a href="#LINK#" class="t-Tabs-link #A04#" data-otel-label="#A10#" #LINK_ATTR#>
                <span class="t-Icon #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                <span class="t-Tabs-label">#TEXT#</span>
              </a>
            </li>
            ```
        noncurrent:
            ```html
            <li class="t-Tabs-item #A03#" id="#A01#">
              <a href="#LINK#" class="t-Tabs-link #A04#" data-otel-label="#A10#" #LINK_ATTR#>
                <span class="t-Icon #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                <span class="t-Tabs-label">#TEXT#</span>
              </a>
            </li>
            ```
    }
    javaScript {
        fileUrls: #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.apexTabs#MIN#.js?v=#APEX_VERSION#
    }
    attributeDescriptions {
        a01: List Item ID
        a03: List Item Class
        a04: Link Class
        a10: OpenTelemetry Label
    }

    templateOption above-label (
        name: Above Label
        group: @list/icons
        sequence: 20
        appearance {
            cssClasses: t-Tabs--iconsAbove
        }
        help {
            helpText: Places icons above tab label.
        }
    )

    templateOption inline-with-label (
        name: Inline with Label
        group: @list/icons
        sequence: 10
        appearance {
            cssClasses: t-Tabs--inlineIcons
        }
    )

    templateOption fill-labels (
        name: Fill Labels
        group: @list/layout
        sequence: 1
        appearance {
            cssClasses: t-Tabs--fillLabels
        }
        help {
            helpText: Stretch tabs to fill to the width of the tabs container.
        }
    )

    templateOption large (
        name: Large
        group: @list/size-3
        sequence: 10
        appearance {
            cssClasses: t-Tabs--large
        }
        help {
            helpText: Increases font size and white space around tab items.
        }
    )

    templateOption small (
        name: Small
        group: @list/size-3
        sequence: 5
        appearance {
            cssClasses: t-Tabs--small
        }
    )

    templateOption pill (
        name: Pill
        group: @list/style-2
        sequence: 20
        appearance {
            cssClasses: t-Tabs--pill
        }
        help {
            helpText: Displays tabs in a pill container.
        }
    )

    templateOption simple (
        name: Simple
        group: @list/style-2
        sequence: 10
        appearance {
            cssClasses: t-Tabs--simple
        }
        help {
            helpText: A very simplistic tab UI.
        }
    )

)

