lov activity (
    name: ACTIVITY
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT entry d, NVL(value, entry) r
            FROM drop_down_table_entries
            WHERE type = 'Activity'
            ORDER BY order_by
            ```
    }
)

lov activity-type (
    name: ACTIVITY_TYPE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT extra d, NVL(value, entry) r
            FROM drop_down_table_entries
            WHERE type = 'Activity'
            ORDER BY order_by
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov app-mode (
    name: APP_MODE
    source {
        location: staticValues
    }

    entry a (
        sequence: 2
        display: Admin
        return: A
    )

    entry t (
        sequence: 1
        display: Therapist
        return: T
    )

)

lov applications (
    name: APPLICATIONS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT d, r
            FROM
            (
                SELECT app_name d, TO_CHAR(app_id, 'FM000') r
                FROM applications
                UNION
                SELECT app_name||' Admin' d, TO_CHAR(app_id, 'FM000')||'A' r
                FROM applications
            )
            ORDER BY UPPER(d)
            ```
    }
)

