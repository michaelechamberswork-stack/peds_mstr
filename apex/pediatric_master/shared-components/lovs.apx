lov location (
    name: LOCATION
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT entry d, NVL(value, entry) r
            FROM drop_down_table_entries
            WHERE type = 'Location'
            ORDER BY order_by
            ```
    }
)

lov location-therapist (
    name: LOCATION_THERAPIST
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT d, r
            FROM
            (
                SELECT d, NVL(r, rownum) r, order_by
                FROM
                (
                    SELECT d, r, order_by
                    FROM
                    (
                        SELECT entry d, NVL(value, entry) r, order_by
                        FROM drop_down_table_entries
                        WHERE type = 'Location'
            
                        UNION
            
                        SELECT location_other, NULL, NULL
                        FROM case_folder
                        WHERE therapist_id = :APP_USER_ID
                            AND location_other IS NOT NULL
                        GROUP BY location_other
                    )
                    ORDER BY order_by, UPPER(d)
                )
            )
            ORDER BY order_by NULLS LAST, UPPER(d)
            
            ```
    }
)

lov program (
    name: PROGRAM
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT name d, p_id r
            FROM programs
            ORDER BY UPPER(name)
            ```
    }
)

lov program-service-code (
    name: PROGRAM_SERVICE_CODE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT psc_description, psc_id
            FROM program_service_codes psc
                INNER JOIN programs p ON psc.psc_p_id = p.p_id
                INNER JOIN clients c ON p.p_id = c.p_id
            WHERE c.case_number = :CURRENT_CLIENT
            
            ```
    }
    columnMapping {
        return: PSC_ID
        display: PSC_DESCRIPTION
        defaultSort: PSC_DESCRIPTION
    }
)

lov read-only-list (
    name: READ_ONLY_LIST
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            SELECT UPPER(last_name||', '||first_name) d, id r
            FROM therapists
            WHERE INSTR(applications, :APP_ID) > 0
            ORDER BY 1
            ```
    }
)

