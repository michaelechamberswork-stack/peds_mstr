lov colors (
    name: COLORS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 'u-color-'||rownum d, 'u-color-'||rownum r
            from all_objects
            where rownum < 50
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }

    column D (
        heading {
            heading: Color
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column R (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
        advanced {
            searchable: false
        }
    )

)

