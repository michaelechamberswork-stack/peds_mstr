customAttribute attribute_01 (
    apexlangName: mailgunPublicApiKey
    attribute: 1
    name: Mailgun Public API Key
    scope: app
    validation {
        required: true
        maxLength: 100
    }
    appearance {
        sequence: 10
    }
    builder {
        displayWidth: 50
    }
    help {
        helpText: Get your Mailgun Public API Key from https://mailgun.com. Warning: don't use your private key!
    }
)

customAttribute attribute_01 (
    apexlangName: showValidationResult
    attribute: 1
    name: Show Validation Result
    type: yesNo
    appearance {
        sequence: 10
    }
    default {
        value: true
    }
    help {
        helpText: Adds a span immediately after the item where the loading icon, success and error indicators and messages will be shown. Set this to No if you are going to use the plugin triggers to implement your own handling and display of the validation results.
    }
)

customAttribute attribute_02 (
    apexlangName: messageWhenAddressIsInvalid
    attribute: 2
    name: Message when address is invalid
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: Address is invalid.
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Message text to show if email fails validation.
    }
)

