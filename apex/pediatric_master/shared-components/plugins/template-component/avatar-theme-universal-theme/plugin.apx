plugin avatar (
    name: Avatar
    staticId: THEME_142$AVATAR
    theme: @universal-theme
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            {if APEX$IS_LAZY_LOADING/}
              <span class="t-Avatar is-placeholder{if ?SHAPE/} #SHAPE#{endif/}{if ?SIZE/} #SIZE#{endif/}{if ?CSS_CLASSES/} #CSS_CLASSES#{endif/}"></span>
            {else/}
              {if ?LINK/}<a href="#LINK#" #LINK_ATTR#{else/}<span{endif/} class="t-Avatar{if ?TYPE/} t-Avatar--{if ?IMAGE/}image{else/}{if ?INITIALS/}initials{else/}icon{endif/}{endif/}{endif/}{if ?SHAPE/} #SHAPE#{endif/}{if ?SIZE/} #SIZE#{endif/}{if ?ICON/} #ICON#{else/} fa fa-user{endif/}{if ?CSS_CLASSES/} #CSS_CLASSES#{endif/} u-color" {if !IMAGE/}{if DESCRIPTION/} role="img" aria-label="#DESCRIPTION#" title="#DESCRIPTION#"{else/} aria-hidden="true"{endif/}{endif/}>{if IMAGE/}<img src="#IMAGE#" alt="#DESCRIPTION#"{if ?DESCRIPTION/} title="#DESCRIPTION#"{endif/} loading="lazy" />{else/}{if ?INITIALS/}#INITIALS#{endif/}{endif/}{if ?LINK/}</a>{else/}</span>{endif/}
            {endif/}
            ```
        reportBody: "<ul class=\"t-Avatars {if SPACING/}#SPACING#{endif/} #APEX$COMPONENT_CSS_CLASSES#\">#APEX$ROWS#</ul>"
        reportGroup:
            ```html
            <li class="t-Avatar-groupItem" #APEX$GROUP_IDENTIFICATION#>
              {if ?GROUP_TITLE/}
              <div class="t-Avatar-groupHeader">
                {if ?GROUP_ICON/}<span class="t-Avatar-groupIcon #GROUP_ICON#" aria-hidden="true"></span>{endif/}
                <h2 class="t-Avatar-groupTitle" id="#APEX$DOM_ID#_heading">#GROUP_TITLE#</h2>
              </div>
              {endif/}
              <ul class="t-Avatar-groupItems">#APEX$ROWS#</ul>
            </li>
            
            ```
        reportRow: <li class="t-Avatars-item" #APEX$ROW_IDENTIFICATION#>#APEX$PARTIAL#</li>
        numberOfLazyLoadingSkeletons: 3
    }
    component {
        standardAttributes: regionTemplateAttr
    }
    source {
        sampleData: employees
    }
    information {
        version: 1.0
        helpText: Display an image, icon, or initials. Available as a partial template to display a single row.
    }
)

