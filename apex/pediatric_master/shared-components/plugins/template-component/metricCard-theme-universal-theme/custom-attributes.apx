customAttribute AVATAR_ALIGNMENT (
    apexlangName: alignment
    attribute: 31
    name: Alignment
    type: selectList
    validation {
        required: true
    }
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @avatar
        sequence: 310
    }
    default {
        value: t-MetricCard-body--avatarAlignmentStart
    }
    dependingOn {
        attribute: @AVATAR_POSITION/component
        conditionType: =
        value: t-MetricCard-body--avatarPositionInline
    }
    help {
        helpText: Choose the vertical alignment of the Avatar: Start (Top), Center (Middle), or End (Bottom).
    }

    entry center (
        sequence: 20
        display: Center
        return: t-MetricCard-body--avatarAlignmentCenter
    )

    entry end (
        sequence: 30
        display: End
        return: t-MetricCard-body--avatarAlignmentEnd
    )

    entry start (
        sequence: 10
        display: Start
        return: t-MetricCard-body--avatarAlignmentStart
    )

)

customAttribute AVATAR_ICON (
    apexlangName: icon
    attribute: 26
    name: Icon
    type: icon
    validation {
        required: true
    }
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @avatar
        sequence: 260
    }
    default {
        value: fa-line-chart
    }
    dependingOn {
        attribute: @AVATAR_TYPE/component
        conditionType: =
        value: icon
    }
    help {
        helpText: Enter an icon class or use the Pick Icon dialog to select the icon you want to add to display in the avatar.
    }
)

customAttribute AVATAR_IMAGE (
    apexlangName: image
    attribute: 24
    name: Image
    type: media
    validation {
        required: true
    }
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @avatar
        sequence: 240
    }
    dependingOn {
        attribute: @AVATAR_TYPE/component
        conditionType: =
        value: image
    }
    help {
        helpText:
            ```
            <p>Use the Media popup dialog to select a source for the avatar image.</p>
            
            <p>Available options include:</p>
            <ul>
            <li>URL</li>
            <li>BLOB Column</li>
            <li>URL Column</li>
            </ul>
            ```
    }
)

customAttribute AVATAR_INITIALS (
    apexlangName: initials
    attribute: 25
    name: Initials
    type: sessionStateValue
    validation {
        required: true
    }
    security {
        escapeMode: stripHtml
    }
    appearance {
        attributeGroup: @avatar
        sequence: 250
    }
    default {
        sampleDataValue: INITIALS
    }
    dependingOn {
        attribute: @AVATAR_TYPE/component
        conditionType: =
        value: initials
    }
    help {
        helpText: Select the source column to be displayed within each avatar. Only varchar2 data types are supported.
    }
)

customAttribute AVATAR_POSITION (
    apexlangName: position
    attribute: 28
    name: Position
    type: selectList
    validation {
        required: true
    }
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @avatar
        sequence: 280
    }
    default {
        value: t-MetricCard-body--avatarPositionTop
    }
    dependingOn {
        attribute: @DISPLAY_AVATAR/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Align the Avatar above the content (Top) or beside the content (Inline).
    }

    entry inline (
        sequence: 20
        display: Inline
        return: t-MetricCard-body--avatarPositionInline
    )

    entry top (
        sequence: 10
        display: Top
        return: t-MetricCard-body--avatarPositionTop
    )

)

customAttribute AVATAR_SHAPE (
    apexlangName: shape
    attribute: 27
    name: Shape
    type: selectList
    validation {
        required: true
    }
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @avatar
        sequence: 270
    }
    default {
        value: t-Avatar--rounded
    }
    dependingOn {
        attribute: @DISPLAY_AVATAR/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Select the shape of the avatar. Default inherits the shape set by the containing template.
    }

    entry circular (
        sequence: 20
        display: Circular
        return: t-Avatar--circle
    )

    entry noShape (
        sequence: 40
        display: No Shape
        return: t-Avatar--noShape
    )

    entry rounded (
        sequence: 10
        display: Rounded
        return: t-Avatar--rounded
    )

    entry square (
        sequence: 30
        display: Square
        return: t-Avatar--square
    )

)

customAttribute AVATAR_SIZE (
    apexlangName: size
    attribute: 29
    name: Size
    type: selectList
    componentLov {
        nullText: Default
    }
    appearance {
        attributeGroup: @avatar
        sequence: 275
    }
    dependingOn {
        attribute: @DISPLAY_AVATAR/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Set the size of the avatar. The default inherits the sizing set by the containing template.
    }

    entry large (
        sequence: 50
        display: Large
        return: t-Avatar--lg
    )

    entry medium (
        sequence: 40
        display: Medium
        return: t-Avatar--md
    )

    entry small (
        sequence: 30
        display: Small
        return: t-Avatar--sm
    )

)

customAttribute AVATAR_STYLE (
    apexlangName: style
    attribute: 30
    name: Style
    type: selectList
    componentLov {
        nullText: Default
    }
    appearance {
        attributeGroup: @avatar
        sequence: 265
    }
    dependingOn {
        attribute: @AVATAR_TYPE/component
        conditionType: inList
        list: [
            initials
            icon
        ]
    }

    entry subtle (
        sequence: 10
        display: Subtle
        return: t-MetricCard-avatar--subtle
    )

)

customAttribute AVATAR_TYPE (
    apexlangName: type
    attribute: 23
    name: Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        attributeGroup: @avatar
        sequence: 230
    }
    default {
        value: icon
    }
    dependingOn {
        attribute: @DISPLAY_AVATAR/component
        conditionType: =
        value: Y
    }

    entry icon (
        sequence: 30
        display: Icon
        return: icon
    )

    entry image (
        sequence: 10
        display: Image
        return: image
    )

    entry initials (
        sequence: 20
        display: Initials
        return: initials
    )

)

customAttribute BADGE_ICON (
    apexlangName: icon
    attribute: 8
    name: Icon
    type: icon
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @badge
        sequence: 80
    }
    default {
        sampleDataValue: fa-check-circle-o
    }
    dependingOn {
        attribute: @DISPLAY_BADGE/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter an icon class or use the Pick Icon dialog to select the icon you want to add to display in the badge.
    }
)

customAttribute BADGE_LABEL (
    apexlangName: label
    attribute: 5
    name: Label
    validation {
        required: true
    }
    appearance {
        attributeGroup: @badge
        sequence: 50
    }
    builder {
        translatable: true
    }
    dependingOn {
        attribute: @DISPLAY_BADGE/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter a value for the badge label or select a source column from the quick pick options.
    }
)

customAttribute BADGE_LABEL_DISPLAY (
    apexlangName: displayLabel
    attribute: 9
    name: "Display Label "
    type: yesNo
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @badge
        sequence: 90
    }
    dependingOn {
        attribute: @DISPLAY_BADGE/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Specify whether to display or hide the badge label. When set to Yes, the badge label will be displayed in addition to the badge value. When set to No, only the badge value will be displayed.
    }
)

customAttribute BADGE_SHAPE (
    apexlangName: shape
