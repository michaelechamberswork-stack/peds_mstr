customAttribute BADGE_STATE (
    apexlangName: state
    attribute: 7
    name: State
    type: sessionStateValue
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @badge
        sequence: 70
    }
    dependingOn {
        attribute: @DISPLAY_BADGE/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Select the source column for the state of the badge. Substitute column value with "danger", "warning", "success" or "info" for default styling.
    }
)

customAttribute BADGE_STYLE (
    apexlangName: style
    attribute: 10
    name: Style
    type: selectList
    componentLov {
        nullText: Default
    }
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @badge
        sequence: 100
    }
    dependingOn {
        attribute: @DISPLAY_BADGE/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Select the badge style. Default inherits the style set by the containing template.
    }

    entry outline (
        sequence: 20
        display: Outline
        return: t-Badge--outline
    )

    entry subtle (
        sequence: 10
        display: Subtle
        return: t-Badge--subtle
    )

)

customAttribute BADGE_VALUE (
    apexlangName: value
    attribute: 6
    name: Value
    type: sessionStateValue
    validation {
        required: true
    }
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @badge
        sequence: 60
    }
    default {
        sampleDataValue: Closed
    }
    supports {
        dataTypes: [
            varchar2
            number
            date
            intervalYearToMonth
            intervalDayToSecond
        ]
    }
    dependingOn {
        attribute: @DISPLAY_BADGE/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Select a source column for the badge value.
    }
)

customAttribute DISPLAY_AVATAR (
    apexlangName: displayAvatar
    attribute: 22
    name: Display Avatar
    type: yesNo
    appearance {
        attributeGroup: @avatar
        sequence: 220
    }
    default {
        sampleDataValue: N
    }
    help {
        helpText: Specify whether to display or hide the avatar for each row. When set to Yes, an avatar will be displayed with the assigned image, icon, or initials. When set to No, no avatar will be displayed.
    }
)

customAttribute DISPLAY_BADGE (
    apexlangName: displayBadge
    attribute: 4
    name: Display Badge
    type: yesNo
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @badge
        sequence: 40
    }
    default {
        sampleDataValue: Y
    }
    help {
        helpText: Specify whether to display or hide the badge for each row. When set to Yes, a badge will be displayed in each row. When set to No, no badge will be displayed.
    }
)

customAttribute GROUP_ICON (
    apexlangName: groupIcon
    attribute: 17
    name: Group Icon
    scope: reportGroup
    type: icon
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @grouping
        sequence: 170
    }
    dependingOn {
        attribute: @GROUP_TITLE/reportGroup
        conditionType: isNotNull
    }
)

customAttribute GROUP_TITLE (
    apexlangName: groupTitle
    attribute: 16
    name: Group Title
    scope: reportGroup
    appearance {
        attributeGroup: @grouping
        sequence: 160
    }
)

customAttribute ITEM_CSS_CLASSES (
    apexlangName: itemCssClasses
    attribute: 13
    name: Item CSS Classes
    scope: report
    appearance {
        attributeGroup: @advanced
        sequence: 220
    }
    help {
        helpText: Enter CSS classes to add to the items. You may add multiple classes by separating them with a space.
    }
)

customAttribute LAYOUT (
    apexlangName: layout
    attribute: 15
    name: Layout
    scope: report
    type: selectList
    componentLov {
        nullText: Default
    }
    appearance {
        sequence: 150
    }
    help {
        helpText: Select the number of grid columns the Metric Card content will display in. Auto will display all cards horizontally and wrap automatically.
    }

    entry 2Columns (
        sequence: 20
        display: 2 Columns
        return: 2cols
    )

    entry 3Columns (
        sequence: 30
        display: 3 Columns
        return: 3cols
    )

    entry 4Columns (
        sequence: 40
        display: 4 Columns
        return: 4cols
    )

    entry 5Columns (
        sequence: 50
        display: 5 Columns
        return: 5cols
    )

    entry autoWrapping (
        sequence: 60
        display: Auto (Wrapping)
        return: auto
    )

    entry overflow (
        sequence: 70
        display: Overflow
        return: overflow
    )

    entry stacked (
        sequence: 10
        display: Stacked
        return: stacked
    )

)

customAttribute META (
    apexlangName: meta
    attribute: 3
    name: Meta
    appearance {
        sequence: 30
    }
    default {
        sampleDataValue: Meta
    }
    help {
        helpText: Enter some text and/or column substitution strings to be used as the Meta Attribute in each row.
    }
)

customAttribute META_CSS_CLASSES (
    apexlangName: metaCssClasses
    attribute: 20
    name: Meta CSS Classes
    appearance {
        sequence: 35
    }
    help {
        helpText: Apply typography utility classes or custom CSS to the metric card meta attribute (for example, u-text-heading-sm). You may add multiple classes by separating them with a space.
    }
)

