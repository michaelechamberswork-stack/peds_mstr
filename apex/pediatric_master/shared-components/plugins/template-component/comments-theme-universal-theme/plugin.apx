plugin comments (
    name: Comments
    staticId: THEME_142$COMMENTS
    theme: @universal-theme
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            {if APEX$IS_LAZY_LOADING/}
              <div class="t-Comments-item{if ?COMMENT_CLASS/} #COMMENT_CLASS#{endif/}">
                {if DISPLAY_AVATAR%assigned/}
                  <div class="t-Comments-icon">
                    {if ?APEX$SELECTOR%assigned/}<div class="t-Comments-selection is-placeholder"></div>{endif/}
                    {with/}
                      SIZE:=t-Avatar--xs
                      SHAPE:=#AVATAR_SHAPE#
                    {apply THEME$AVATAR/}
                  </div>
                {endif/}
                <div class="t-Comments-body">
                  <div class="t-Comments-info">
                    <span class="t-Comments-user is-placeholder"></span>
                  </div>
                  <div class="t-Comments-comment is-placeholder"></div>
                </div>
              </div>
            {else/}
              <div class="t-Comments-item{if ?COMMENT_CLASS/} #COMMENT_CLASS#{endif/}">
                {if DISPLAY_AVATAR/}
                  <div class="t-Comments-icon">
                    {if ?APEX$SELECTOR%assigned/}<div class="t-Comments-selection">#APEX$SELECTOR#</div>{endif/}
                    {with/}
                      TYPE:=#AVATAR_TYPE#
                      IMAGE:=#AVATAR_IMAGE#
                      DESCRIPTION:=#AVATAR_DESCRIPTION#
                      ICON:=#AVATAR_ICON#
                      INITIALS:=#AVATAR_INITIALS#
                      SIZE:=t-Avatar--xs
                      SHAPE:=#AVATAR_SHAPE#
                      CSS_CLASSES:=#AVATAR_CSS_CLASSES#
                      LINK:=#AVATAR_LINK#
                      LINK_ATTR:=#AVATAR_LINK_ATTR#
                    {apply THEME$AVATAR/}
                  </div>
                {endif/}
                <div class="t-Comments-body">
                  <div class="t-Comments-info">
                    <span class="t-Comments-user">{if USER_NAME_LINK/}<a href="#USER_NAME_LINK#" #USER_NAME_LINK_ATTR#>{endif/}#USER_NAME#{if USER_NAME_LINK/}</a>{endif/}</span>
                    {if COMMENT_DATE/}<span class="t-Comments-date">#COMMENT_DATE#</span>{endif/}
                    {if ACTIONS/}<span class="t-Comments-actions">#ACTIONS#</span>{endif/}
                  </div>
                  <div class="t-Comments-comment">
                    #COMMENT_TEXT#
                    {if ATTRIBUTES/}<div class="t-Comments-attributes">#ATTRIBUTES#</div>{endif/}
                  </div>
                </div>
              </div>
            {endif/}
            ```
        reportBody:
            ```html
            <ul class="t-Comments{if ?STYLE/} #STYLE#{endif/} {if APPLY_THEME_COLORS/} u-colors{endif/} #APEX$COMPONENT_CSS_CLASSES#">#APEX$ROWS#</ul>
            
            ```
        reportGroup:
            ```html
            <li class="t-Comments-groupItem" #APEX$GROUP_IDENTIFICATION#>
              {if ?GROUP_TITLE/}
              <div class="t-Comments-groupHeader">
                {if ?GROUP_ICON/}<span class="t-Comments-groupIcon #GROUP_ICON#" aria-hidden="true"></span>{endif/}
                <h2 class="t-Comments-groupTitle" id="#APEX$DOM_ID#_heading">#GROUP_TITLE#</h2>
              </div>
              {endif/}
              <ul class="t-Comments-groupItems">#APEX$ROWS#</ul>
            </li>
            ```
        reportRow:
            ```html
            <li class="t-Comments-item {if ?ALIGNMENT/}t-Comments-item--#ALIGNMENT#{endif/}" #APEX$ROW_IDENTIFICATION#>#APEX$PARTIAL#</li>
            
            ```
        numberOfLazyLoadingSkeletons: 3
    }
    component {
        standardAttributes: [
            rowSelection
            regionTemplateAttr
        ]
    }
    source {
        sampleData: tasks
    }
    advanced {
        quickPick: true
    }
    information {
        helpText: Display user comments and status updates. Supports avatars. Available for a single row or as a report with multiple rows.
    }
)

