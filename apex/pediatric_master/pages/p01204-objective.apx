        }
    )

    pageItem P1204_S_ID (
        type: hidden
        layout {
            sequence: 50
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: S_ID
            dataType: number
        }
    )

    pageItem P1204_UPDATED_BY (
        type: hidden
        layout {
            sequence: 100
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: UPDATED_BY
            dataType: varchar2
        }
    )

    pageItem P1204_UPDATED_ON (
        type: hidden
        layout {
            sequence: 110
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: UPDATED_ON
            dataType: date
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 188417228809229369
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-objective (
        name: Initialize form OBJECTIVE
        type: formInitialization
        formRegion: @objective
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 188416407583229369
        }
    )

)

