page 1204 (
    name: OBJECTIVE
    alias: OBJECTIVE
    title: OBJECTIVE
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region objective (
        name: OBJECTIVE
        type: form
        source {
            location: localDatabase
            tableName: NOTES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P1204_CREATED_BY (
        type: hidden
        layout {
            sequence: 80
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P1204_CREATED_ON (
        type: hidden
        layout {
            sequence: 90
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: CREATED_ON
            dataType: date
        }
    )

    pageItem P1204_INTERVENTION (
        type: hidden
        layout {
            sequence: 30
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: INTERVENTION
            dataType: varchar2
        }
    )

    pageItem P1204_LAST_SAVED_BY_LEVEL (
        type: hidden
        layout {
            sequence: 70
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: LAST_SAVED_BY_LEVEL
            dataType: varchar2
        }
    )

    pageItem P1204_N_ID (
        type: hidden
        layout {
            sequence: 10
            region: @objective
            slot: regionBody
        }
        source {
            formRegion: @objective
            column: N_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1204_OBJECTIVE (
        type: displayOnly
        label {
            label: Objective
            alignment: left
        }
        layout {
            sequence: 60
            region: @objective
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @objective
            column: OBJECTIVE
            dataType: varchar2
        }
    )

    pageItem P1204_OBJECTIVE_MET (
        type: hidden
        layout {
