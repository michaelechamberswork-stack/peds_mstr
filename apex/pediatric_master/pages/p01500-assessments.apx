    button new-assessment (
        buttonName: NEW_ASSESSMENT
        label: NEW ASSESSMENT
        layout {
            sequence: 10
            region: @assessment
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1501
                items: {
                    P1501_NEW_ASSESSMENT: Y
                }
                clearCache: 1501
            }
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @excluded
        }
    )

    button new-assessment-v (
        buttonName: NEW_ASSESSMENT_v2022
        label: NEW ASSESSMENT
        layout {
            sequence: 10
            region: @assessment-v
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1502
                items: {
                    P1502_CASE_NUMBER: &CURRENT_CLIENT.
                }
                clearCache: 1502
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: NEW_ASSESSMENT_V2022
            customAttributes: style="display: none;"
        }
    )

    dynamicAction move-button (
        name: move button
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#NEW_ASSESSMENT_V2022").insertAfter("#ASSESSMENT_V2022_heading");
                    $("#NEW_ASSESSMENT_V2022").show();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

