page 1500 (
    name: ASSESSMENTS
    alias: ASSESSMENTS
    title: ASSESSMENT
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region assessment (
        name: ASSESSMENT
        type: classicReport
        source {
            location: localDatabase
            tableName: ASSESSMENT
            whereClause: case_number = :CURRENT_CLIENT
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                from assessment
                where case_number = :CURRENT_CLIENT
                ```
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: NO ASSESSMENT FOUND.
        }

        column ASSESSMENT_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Assessment Date
            }
            layout {
                sequence: 0
            }
        )

        column CASE_NUMBER (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 0
            }
            link {
                target: {
                    page: 1501
                    items: {
                        P1501_CASE_NUMBER: #CASE_NUMBER#
                        P1501_ASSESSMENT_DATE: #ASSESSMENT_DATE#
                    }
                    clearCache: 1501
                }
                linkText: <span aria-hidden="true" class="fa fa-file-o"></span>
            }
        )

        column EDUCATION_GRADE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Education Grade
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
        )

