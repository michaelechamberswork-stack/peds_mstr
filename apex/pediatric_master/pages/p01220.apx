    }

    region create-signature (
        name: Create Signature
        type: plugin/apexSignature
        layout {
            sequence: 20
            parentRegion: @sessions
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: CREATE_SIG
        }
        settings {
            width: 500
            height: 250
            penColor: black
            plsqlCode:
                ```plsql
                DECLARE
                    l_clob CLOB;
                    l_blob BLOB;
                    l_filename VARCHAR2(100);
                    l_token VARCHAR2(32000);
                BEGIN
                    -- build CLOB from f01 30k Array
                    dbms_lob.createtemporary(l_clob,
                                           FALSE,
                                           dbms_lob.session);
                
                    FOR i IN 1 .. apex_application.g_f01.count LOOP
                        l_token := wwv_flow.g_f01(i);
                  
                        IF length(l_token) > 0 THEN
                            dbms_lob.writeappend(
                                l_clob,
                                length(l_token),
                                l_token);
                        END IF;
                    END LOOP;
                  --
                  -- convert base64 CLOB to BLOB (mimetype: image/png)
                  l_blob := apex_web_service.clobbase642blob(p_clob => l_clob);
                  --
                  -- create own collection (here starts custom part (for example a Insert statement))
                  UPDATE session_review
                  SET reviewer_signature = l_blob,
                      reviewer_date = et_sysdate
                  WHERE case_number = :CURRENT_CLIENT
                      AND sr_date = :P1220_REPORT_MONTH;      
                END;
                ```
            clearButtonJquerySelector: #SIG_CLEAR
            saveButtonJquerySelector: #SIG_SAVE
            showWaitspinner: true
            logging: false
        }
    )

    region session-review (
        name: Session Review
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    session_month list_title,
                    nvl2(reviewer_signature, 'Reviewed', 'To be Reviewed') list_text,
                    'javascript: apex.event.trigger(document, ''ReportMonthSelected'', ''' || session_month || ''');' link
                FROM 
                    case_folder_session_mstr c
                    left join session_review s on s.sr_date = c.session_month and s.case_number = c.case_number 
                WHERE
                    c.case_number = :CURRENT_CLIENT
                ORDER BY session_month DESC
                
                /*
                SELECT 
                    session_month list_title,
                    null list_text,
                    'javascript: apex.event.trigger(document, ''ReportMonthSelected'', ''' || session_month || ''');' link
                FROM 
                    case_folder_session_mstr
                WHERE
                    case_number = :CURRENT_CLIENT
                ORDER BY session_month DESC
                */
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: [
                col-sm-12
                col-md-10
                col-lg-8
                div-expand
            ]
        }
