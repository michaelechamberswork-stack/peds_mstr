    )

    process create-session-review-entries (
        name: Create Session Review Entries
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                INSERT INTO session_review(sr_date, case_number)
                SELECT DISTINCT TRUNC(date_session, 'MM'), case_number
                FROM sessions
                WHERE case_number = :CURRENT_CLIENT
                    AND TRUNC(date_session, 'MM') NOT IN
                    (
                        SELECT sr_date
                        FROM session_review
                        WHERE case_number = :CURRENT_CLIENT
                    );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1723656404064423
        }
    )

)

