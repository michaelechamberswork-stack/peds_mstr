page 1302 (
    name: NOTES
    title: NOTES
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region notes (
        name: NOTES
        type: form
        source {
            location: localDatabase
            tableName: NOTES
            includeRowidColumn: true
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
    )

    pageItem P1302_INTERVENTION (
        type: textarea
        label {
            label: INTERVENTION
            alignment: left
        }
        layout {
            sequence: 50
            region: @notes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @notes
            column: INTERVENTION
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1302_N_ID (
        type: hidden
        layout {
            sequence: 10
            region: @notes
            slot: regionBody
        }
        source {
            formRegion: @notes
            column: N_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P1302_OBJECTIVE (
        type: textarea
        label {
            label: OBJECTIVE
            alignment: left
        }
        layout {
            sequence: 40
            region: @notes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @notes
            column: OBJECTIVE
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1302_O_ID (
        type: hidden
        layout {
            sequence: 20
            region: @notes
            slot: regionBody
        }
        source {
            formRegion: @notes
            column: O_ID
            dataType: number
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1302_PROGRESS (
        type: textarea
        label {
            label: PROGRESS
            alignment: left
        }
        layout {
            sequence: 60
            region: @notes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @notes
            column: PROGRESS
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1302_S_ID (
        type: hidden
        layout {
            sequence: 30
            region: @notes
            slot: regionBody
        }
        source {
            formRegion: @notes
            column: S_ID
            dataType: number
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: CANCEL
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1301
                items: {
                    P1301_S_ID: &P1302_S_ID.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: DELETE
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vNum NUMBER;
                    vDate DATE;
                BEGIN
                    IF :APP_MODE = 'T' THEN
                        RETURN FALSE;
                    END IF;
                    
                    SELECT date_session
                    INTO vDate
                    FROM sessions s
                    WHERE s_id = :P1302_S_ID;
                    
                    SELECT COUNT(*)
                    INTO vNum
                    FROM objectives o
                    WHERE o_id = :P1302_O_ID
                        AND vDAte BETWEEN start_date AND NVL(end_date, vDate + 1);
                
                    RETURN vNum = 0;
                END;
                ```
        }

        triggerAction native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
            }
        )

        triggerAction plugin-be-ctb-alertify (
            action: plugin/alertify
            settings {
                dialogType: confirm
                message: Delete the objective from this session?
            }
            execution {
                sequence: 10
            }
        )

    )

    button save (
        buttonName: SAVE
        label: OK
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1302_N_ID
        }
    )

    process fetch-row-from-notes (
        name: Fetch Row from NOTES
        type: formInitialization
        formRegion: @notes
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6453801690034427
        }
    )

    process process-row-of-notes (
        name: Process Row of NOTES
        type: formAutoRowProcessing
        formRegion: @notes
        target {
            returnPksAfterInsert: false
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 6454280733034427
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 6454612832034427
        }
    )

    branch (
        name: Branch to Session
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1301
                clearCache: 1302
                action: resetPagination
            }
        }
    )

)

