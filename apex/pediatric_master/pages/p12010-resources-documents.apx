page 12010 (
    name: RESOURCES DOCUMENTS
    alias: RESOURCES-DOCUMENTS
    title: RESOURCES DOCUMENTS
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region resources (
        name: RESOURCES
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    rd_id,
                    rd_id download_link,
                    description,
                    applications,
                    keywords,
                    lastupdated,
                    filename
                FROM resources
                WHERE url is null
                AND INSTR(':'||app_ids||':', ':'||:APP_ID||':') > 0
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 162866966200916640
        }

        column APPLICATIONS (
            type: hidden
            heading {
                heading: APPLICATIONS
            }
            layout {
                sequence: 41
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: DESCRIPTION
                alignment: center
            }
            layout {
                sequence: 31
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DOWNLOAD_LINK (
            type: link
            heading {
                heading: -
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            link {
                target: {
                    page: 0
                    items: {
                        RD_ID: #RD_ID#
                    }
                    request: APPLICATION_PROCESS=DOWNLOAD_RESOURCE_DOCUMENT
                }
                linkText: <span aria-hidden="true" class="fa fa-cloud-arrow-down"></span>
                linkAttributes: target="_blank"
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column FILENAME (
            type: plainText
            heading {
                heading: FILENAME
                alignment: center
            }
            layout {
                sequence: 71
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column KEYWORDS (
            type: plainTextBasedOnLov
            heading {
                heading: KEYWORDS
                alignment: center
            }
            lov {
                lov: @applications
            }
            layout {
                sequence: 51
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LASTUPDATED (
            type: plainText
            heading {
                heading: LAST UPDATED
                alignment: center
            }
            layout {
                sequence: 61
            }
            appearance {
                formatMask: MM/DD/YYYY HH:MI AM
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column RD_ID (
            type: hidden
            heading {
                heading: -
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 107803 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPTION (
                sequence: 2
            )

            displayColumn DOWNLOAD_LINK (
                sequence: 1
            )

            displayColumn FILENAME (
                sequence: 4
            )

            displayColumn KEYWORDS (
                sequence: 3
            )

            displayColumn LASTUPDATED (
                sequence: 5
            )

        )

    )

)

