page 2001 (
    name: STATE
    title: STATE
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region search (
        name: Search
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                col-sm-12
                col-md-10
                col-lg-8
            ]
        }
        settings {
            outputAs: text
        }
    )

    region state (
        name: STATE
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from (
                SELECT name d, abbreviation r
                FROM states
                ORDER BY 1
                ) where (
                 instr(upper("D"),upper(nvl(:P2001_REPORT_SEARCH,"D"))) > 0 
                )
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                col-sm-12
                col-md-10
                col-lg-8
            ]
        }
        reportLayout {
            numberOfRowsType: itemValue
            item: P2001_ROWS
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }

        column D (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: STATE
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    type: url
                    url: javascript: apex.navigation.dialog.close(true, parent.$s('&RF.', '#R#'));
                }
                linkText: #D#
            }
            sorting {
                sortable: false
            }
        )

        column R (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

    )

    pageItem P2001_REPORT_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        settings {
            trimSpaces: none
            submitWhenEnterPressed: true
        }
        layout {
            sequence: 20
            region: @search
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 2000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P2001_ROWS (
        type: selectList
        label {
            label: Display
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @report-rows-per-page
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @search
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: 15
        }
        default {
            type: static
            staticValue: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem RF (
        type: hidden
        layout {
            sequence: 10
            region: @search
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button go (
        buttonName: GO
        label: Go
        layout {
            sequence: 40
            region: @search
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 50
            region: @search
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process reset-pagination (
        name: Reset Pagination
        type: resetPagination
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6032053880387411
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GO,P2001_REPORT_SEARCH,RESET
        }
    )

    process reset-report-search (
        name: Reset report search
        type: clearSessionState
        clear {
            type: items
            items: [
                P2001_REPORT_SEARCH
                P2001_ROWS
            ]
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 6032443852387412
        }
        serverSideCondition {
            whenButtonPressed: @reset
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 2001
                successMessage: false
            }
        }
    )

)

