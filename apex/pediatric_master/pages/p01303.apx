            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: MM/DD/YYYY HH:MI AM
            width: 30
        }
        source {
            formRegion: @late-reason
            column: DATE_CREATED
            dataType: date
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
