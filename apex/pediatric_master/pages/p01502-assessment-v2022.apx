    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @selector
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1500
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @selector
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P1502_CASE_NUMBER is null or :P1502_ASSESSMENT_DATE is null
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @selector
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P1502_CASE_NUMBER is not null and :P1502_ASSESSMENT_DATE is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @selector
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P1502_CASE_NUMBER is not null and :P1502_ASSESSMENT_DATE is not null
        }
    )

    dynamicAction set-text-fields (
        name: set text fields 100%
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("input[type='text']:not([id*='_DATE_'])").each(function() {
                        $(this).parent().css('width', '100%');
                        $(this).css('width', '100%');
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show-hide-other (
        name: Show / Hide OTHER
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P1502_TREATMENT_PLAN_RECREATION_THERAPY_OBJECTIVES_COGNITIVE_SKILLS
                P1502_TREATMENT_PLAN_RECREATION_THERAPY_OBJECTIVES_PHYSICAL_SKILLS
                P1502_TREATMENT_PLAN_RECREATION_THERAPY_OBJECTIVES_SOCIALIZATION_EMOTIONAL_SKILLS
                P1502_TREATMENT_PLAN_LEISURE_EDUCATION
                P1502_TREATMENT_PLAN_RECREATION_PARTICIPATION
            ]
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: apex.item(this.triggeringElement.id).displayValueFor(apex.item(this.triggeringElement.id).getValue()).toUpperCase().includes('OTHER')
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: javaScriptExpression
                javaScriptExpression: $('#' + this.triggeringElement.id + '_OTHER')
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: javaScriptExpression
                javaScriptExpression: $('#' + this.triggeringElement.id + '_OTHER')
            }
            execution {
                sequence: 10
            }
        )

    )

