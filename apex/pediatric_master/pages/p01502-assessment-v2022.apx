    process process-form-assessment-v (
        name: Process form ASSESSMENT v2022
        type: formAutoRowProcessing
        formRegion: @assessment-v
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 105567590285965518
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1500
            }
        }
    )

)

