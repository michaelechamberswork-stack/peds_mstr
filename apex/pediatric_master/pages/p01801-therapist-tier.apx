page 1801 (
    name: Therapist Tier
    alias: THERAPIST-TIER
    title: Therapist Tier
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region therapist-tier (
        name: Therapist Tier
        type: form
        source {
            location: localDatabase
            tableName: THERAPIST_TIER
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P1801_THERAPIST_ID (
        type: popupLov
        label {
            label: New
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @therapists-all
        }
        layout {
            sequence: 10
            region: @therapist-tier
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @therapist-tier
            column: THERAPIST_ID
            dataType: number
            primaryKey: true
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1801_TIER (
        type: numberField
        label {
            label: Tier
            alignment: left
        }
        layout {
            sequence: 20
            region: @therapist-tier
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @therapist-tier
            column: TIER
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    process add-therapist-tier-entry (
        name: Add Therapist Tier Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    insert into therapist_tier(therapist_id, tier)
                    values (:P1801_THERAPIST_ID, 0);
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 50085462570852730
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select *
                from therapist_tier
                where therapist_id = :P1801_THERAPIST_ID
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 31784009889614526
        }
    )

    process initialize-form-therapist-tier (
        name: Initialize form Therapist Tier
        type: formInitialization
        formRegion: @therapist-tier
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 31783257060614525
        }
    )

    process process-form-therapist-tier (
        name: Process form Therapist Tier
        type: formAutoRowProcessing
        formRegion: @therapist-tier
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 31783655941614525
        }
    )

)

