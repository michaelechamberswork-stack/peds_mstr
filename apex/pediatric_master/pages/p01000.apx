    dynamicAction move-and-trigger-show-hide-buttons (
        name: Move and Trigger Show/Hide Buttons
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#ADD_CLIENT").insertAfter("#SELECT_CLIENT_SEARCH_fr_search");
                    $("#HIDE_INACTIVE").insertAfter("#SELECT_CLIENT_SEARCH_fr_search");
                    $("#SHOW_INACTIVE").insertAfter("#SELECT_CLIENT_SEARCH_fr_search");
                    $('#P1000_SELECT_CLIENT_SHOW_INACTIVE').trigger('change');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction select-client-report-refresh (
        name: Select Client Report Refresh
        execution {
            sequence: 60
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @select-client-report
        }

        action set-row-colors (
            name: Set Row Colors
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('.lts-bg-color').each(function() {
                        $(this).parents('tr').children('td').addClass( $(this).attr('class') ) ;
                        $(this).parents('tr').children('td').removeClass('lts-bg-color') ;
                        $(this).parents('tr').addClass('lts-bg-color') ;
                        $(this).parents('tr').attr('href', $(this).attr('href'));
                        $(this).parents('tr').children('td').on('click', function(event){event.preventDefault();apex.navigation.redirect($(this).parents('tr').attr('href'))});
                        $('#' + $(this).parents('td').attr('headers')).hide();
                        $(this).parents('td').hide();
                        $(this).removeClass();
                    });
                    
                    $('.lts-alert-class').each(function() {
                        $(this).parents('td').removeClass(function (index, className) {
                            return (className.match (/(^|\s)u-color-\S+/g) || []).join(' ');
                        });
                        $(this).removeClass('lts-alert-class');
                        $(this).parents('td').addClass( $(this).attr('class') ) ;
                        $(this).remove();
                    });
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction set-row-colors (
