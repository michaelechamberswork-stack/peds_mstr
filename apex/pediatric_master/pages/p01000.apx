    region select-client-report (
        name: SELECT CLIENT REPORT
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH client_sessions AS (
                    select
                        case_number, 
                        sessions_this_month(case_number) num_sessions
                    from clients
                ),
                client_list AS (
                    SELECT 
                        clients.case_number, 
                        first_name link,
                        first_name,
                        last_name,
                        therapist_id,
                        name program,
                        num_sessions,
                        active, 
                        CASE WHEN therapist_id = lts_user.get_therapist_id 
                                OR :APP_MODE = 'A' 
                                OR INSTR(':'||therapist_student_ids||':', ':'||lts_user.get_therapist_id||':') > 0 THEN
                            'N'
                        ELSE
                            'Y'
                        END read_only_access,
                        color_css_code,
                        num_sessions_allowed_per_month,
                        case 
                            when nvl(num_sessions_allowed_per_month, 100) <= num_sessions then 
                                '<span class="lts-alert-class u-danger"></span>' 
                            when nvl(num_sessions_allowed_per_month, 100) - num_sessions = 1 then 
                                '<span class="lts-alert-class u-warning"></span>' 
                            else
                                null
                            end alert_span
                    FROM clients
                        join client_sessions on clients.case_number = client_sessions.case_number
                        left join programs using (p_id)
                    WHERE 
                        (
                            :APP_MODE = 'A'
                            OR
                            (
                                therapist_id = lts_user.get_therapist_id
                                AND
                                active = 'Y'
                            )
                            OR
                            (
                                INSTR(':'||therapist_readonly_ids||':', ':'||lts_user.get_therapist_id||':') > 0
                            )
                            OR
                            (
                                INSTR(':'||therapist_student_ids||':', ':'||lts_user.get_therapist_id||':') > 0
                            )
                        )
                        AND  
                        (
                            INSTR(UPPER(first_name), UPPER(NVL(:P1000_REPORT_SEARCH, first_name))) > 0
                            OR INSTR(UPPER(last_name), UPPER(NVL(:P1000_REPORT_SEARCH, last_name))) > 0 
                        )
                        AND
                        (
                            active = 'Y'
                            OR
                            NVL(:P1000_SELECT_CLIENT_SHOW_INACTIVE, 'N') = 'Y'
                        )
                )
                SELECT 
                    case_number, 
                    link,
                    first_name,
                    last_name,
                    therapist_id,
                    program,
                    num_sessions || NVL2(num_sessions_allowed_per_month, ' of ' || num_sessions_allowed_per_month || alert_span, null) num_sessions,
                    active, 
                    read_only_access,
                    color_css_code,
                    survey.notification_flag(case_number) notification_flag
                FROM client_list
                
                ```
            pageItemsToSubmit: P1000_SELECT_CLIENT_SHOW_INACTIVE
        }
        layout {
            sequence: 20
            parentRegion: @select-client
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
