page 1000 (
    name: SELECT CLIENT
    title: SELECT CLIENT
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region select-client (
        name: SELECT CLIENT
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region select-client-hidden-items (
        name: SELECT_CLIENT_HIDDEN_ITEMS
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @select-client
            slot: subRegions
