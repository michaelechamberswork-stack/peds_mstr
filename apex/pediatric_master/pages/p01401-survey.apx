page 1401 (
    name: SURVEY
    alias: SURVEY
    title: SURVEY
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region action-plan (
        name: action plan
        type: staticContent
        layout {
            sequence: 200
            parentRegion: @survey-form
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region barriers (
        name: barriers
        type: staticContent
        layout {
            sequence: 190
            parentRegion: @survey-form
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region survey-form (
        name: SURVEY_FORM
        type: form
        source {
            location: localDatabase
            tableName: SURVEY_6_MONTH
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P1401_ACTION_PLAN_CHILD (
        type: textarea
        label {
            label: client will
            alignment: left
        }
        layout {
            sequence: 220
            region: @action-plan
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: ACTION_PLAN_CHILD
            dataType: varchar2
        }
    )

    pageItem P1401_ACTION_PLAN_FAMILY (
        type: textarea
        label {
            label: family will
            alignment: left
        }
        layout {
            sequence: 210
            region: @action-plan
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: ACTION_PLAN_FAMILY
            dataType: varchar2
        }
    )

    pageItem P1401_ACTION_PLAN_THERAPIST (
        type: textarea
        label {
            label: therapist will
            alignment: left
        }
        layout {
            sequence: 200
            region: @action-plan
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: ACTION_PLAN_THERAPIST
            dataType: varchar2
        }
    )

    pageItem P1401_BARRIERS (
        type: textarea
        label {
            label: list barriers therapist, family, and/or client may encounter
            alignment: left
        }
        layout {
            sequence: 10
            region: @barriers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: BARRIERS
            dataType: varchar2
        }
    )

    pageItem P1401_CASE_NUMBER (
        type: hidden
        layout {
            sequence: 40
            region: @survey-form
            slot: regionBody
        }
        source {
            formRegion: @survey-form
            column: CASE_NUMBER
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :CURRENT_CLIENT
        }
    )

    pageItem P1401_CLIENT_HIGHLIGHTS_OF_THERAPY_1 (
        type: textarea
        label {
            label: Client/Family Highlights of Recreational Therapy
            alignment: left
        }
        layout {
            sequence: 110
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: CLIENT_HIGHLIGHTS_OF_THERAPY_1
            dataType: varchar2
        }
    )

    pageItem P1401_CLIENT_HIGHLIGHTS_OF_THERAPY_2 (
        type: textarea
        label {
            alignment: left
        }
        layout {
            sequence: 120
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @no-label
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: CLIENT_HIGHLIGHTS_OF_THERAPY_2
            dataType: varchar2
        }
    )

    pageItem P1401_CLIENT_HIGHLIGHTS_OF_THERAPY_3 (
        type: textarea
        label {
            alignment: left
        }
        layout {
            sequence: 130
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @no-label
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: CLIENT_HIGHLIGHTS_OF_THERAPY_3
            dataType: varchar2
        }
    )

    pageItem P1401_CLIENT_NAME (
        type: popupLov
        label {
            label: name
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @clients
        }
        layout {
            sequence: 50
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: item
            item: CURRENT_CLIENT
        }
        readOnly {
            type: always
        }
    )

    pageItem P1401_DATE_REVIEW (
        type: plugin/ltsDateField
        label {
            label: DATE OF REVIEW
            alignment: left
        }
        layout {
            sequence: 80
            region: @survey-form
            slot: regionBody
            startNewRow: false
            column: 4
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @survey-form
            column: DATE_REVIEW
            dataType: date
        }
    )

    pageItem P1401_DISCHARGE_PLAN (
        type: textarea
        label {
            label: Discharge Plan
            alignment: left
        }
        layout {
            sequence: 210
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: DISCHARGE_PLAN
            dataType: varchar2
        }
    )

    pageItem P1401_GOAL_SKILL_CONTINUE_WORKING (
        type: textarea
        label {
            label: Goal and Skill Areas to Continue Working On
            alignment: left
        }
        layout {
            sequence: 140
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: GOAL_SKILL_CONTINUE_WORKING
            dataType: varchar2
        }
    )

    pageItem P1401_NEW_AREAS_WORK_ON (
        type: textarea
        label {
            label: New Areas to Work On
            alignment: left
        }
        layout {
            sequence: 150
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: NEW_AREAS_WORK_ON
            dataType: varchar2
        }
    )

    pageItem P1401_ORIGINAL_ASSESSMENT_DATE (
        type: plugin/ltsDateField
        label {
            label: ORIGINAL ASSESSMENT DATE
            alignment: left
        }
        layout {
            sequence: 70
            region: @survey-form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: expression
            plsqlExpression: tools.client_original_assessment_date(:CURRENT_CLIENT)
        }
        readOnly {
            type: always
        }
    )

    pageItem P1401_OVERVIEW_GOALS_SKILLS_WORKED_ON (
        type: textarea
        label {
            label: Brief Overview of Goals and Skills Worked on
            alignment: left
        }
        layout {
            sequence: 100
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: OVERVIEW_GOALS_SKILLS_WORKED_ON
            dataType: varchar2
        }
    )

    pageItem P1401_PRESENT_FOR_REVIEW (
        type: textarea
        label {
            label: individuals Present For Review
            alignment: left
        }
        layout {
            sequence: 90
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: PRESENT_FOR_REVIEW
            dataType: varchar2
        }
    )

    pageItem P1401_SURVEY_ID (
        type: hidden
        layout {
            sequence: 30
            region: @survey-form
            slot: regionBody
        }
        source {
            formRegion: @survey-form
            column: SURVEY_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1401_THERAPIST_ID (
        type: popupLov
        label {
            label: THERAPIST
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @therapists
        }
        layout {
            sequence: 60
            region: @survey-form
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @survey-form
            column: THERAPIST_ID
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: tools.client_therapist_id(:CURRENT_CLIENT)
        }
    )

    pageItem P1401_UPDATED_GOALS_MOVING_FORWARD_1 (
        type: textarea
        label {
            label: Updated Goals Moving Forward:
            alignment: left
        }
        layout {
            sequence: 160
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: UPDATED_GOALS_MOVING_FORWARD_1
            dataType: varchar2
        }
    )

    pageItem P1401_UPDATED_GOALS_MOVING_FORWARD_2 (
        type: textarea
        label {
            alignment: left
        }
        layout {
            sequence: 170
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @no-label
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: UPDATED_GOALS_MOVING_FORWARD_2
            dataType: varchar2
        }
    )

    pageItem P1401_UPDATED_GOALS_MOVING_FORWARD_3 (
        type: textarea
        label {
            alignment: left
        }
        layout {
            sequence: 180
            region: @survey-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @no-label
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @survey-form
            column: UPDATED_GOALS_MOVING_FORWARD_3
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @survey-form
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1400
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @survey-form
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P1401_SURVEY_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @survey-form
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1401_SURVEY_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @survey-form
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1401_SURVEY_ID
        }
    )

    process initialize-form-survey-form (
        name: Initialize form SURVEY_FORM
        type: formInitialization
        formRegion: @survey-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 54959004306646278
        }
    )

    process process-form-survey-form (
        name: Process form SURVEY_FORM
        type: formAutoRowProcessing
        formRegion: @survey-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 54959414796646278
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1400
            }
        }
    )

)

