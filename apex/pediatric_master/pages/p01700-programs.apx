page 1700 (
    name: PROGRAMS
    alias: PROGRAMS
    title: PROGRAMS
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region programs (
        name: PROGRAMS
        type: classicReport
        source {
            location: localDatabase
            tableName: PROGRAMS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ACCT_NUM (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column ADDRESS1 (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Address1
            }
            layout {
                sequence: 30
            }
        )

        column ADDRESS2 (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Address2
            }
            layout {
                sequence: 40
            }
        )

        column CITY (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: City
            }
            layout {
                sequence: 50
            }
        )

        column COLOR_CSS_CODE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

        column COST_NUM (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column CREATED_BY (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 130
            }
        )

        column CREATED_ON (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 1
            }
        )

        column NUM_SESSIONS_ALLOWED_PER_MONTH (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 110
            }
        )

        column P_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: &nbsp;
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            link {
                target: {
                    page: 1701
                    items: {
                        P1701_P_ID: #P_ID#
                    }
                }
                linkText: &ICON_EDIT.
                linkAttributes: class="lts-bg-color #COLOR_CSS_CODE#"
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ROW_VERSION (
            reportColumnQueryId: 17
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column STATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: State
            }
            layout {
                sequence: 60
            }
        )

        column UPDATED_BY (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column UPDATED_ON (
            reportColumnQueryId: 16
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

        column VEND_NUM (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 100
            }
        )

        column ZIP (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Zip
            }
            layout {
                sequence: 70
            }
        )

    )

    dynamicAction set-row-colors (
        name: Set Row Colors
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('.lts-bg-color').each(function() {
                        $(this).parents('tr').children('td').addClass( $(this).attr('class') ) ;
                        $(this).parents('tr').children('td').removeClass('lts-bg-color') ;
                        $(this).parents('tr').addClass('lts-bg-color') ;
                        $(this).parents('tr').attr('href', $(this).attr('href'));
                        $(this).parents('tr').children('td').on('click', function(event){event.preventDefault();apex.navigation.redirect($(this).parents('tr').attr('href'))});
                        $('#' + $(this).parents('td').attr('headers')).hide();
                        $(this).parents('td').hide();
                        $(this).removeClass();
                    });
                    
                    $('.lts-alert-class').each(function() {
                        $(this).parents('td').removeClass(function (index, className) {
                            return (className.match (/(^|\s)u-color-\S+/g) || []).join(' ');
                        });
                        $(this).removeClass('lts-alert-class');
                        $(this).parents('td').addClass( $(this).attr('class') ) ;
                        $(this).remove();
                    });
                    
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

