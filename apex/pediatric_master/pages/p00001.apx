        }
        advanced {
            customAttributes: target="_blank"
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.open("&REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/invoice.rpt&prompt1=-1&prompt2=&P1_PREVIOUS_MONTH.&prompt3=A")
            }
            execution {
                sequence: 20
            }
        )

    )

    button billing-previous-month-with-notes (
        buttonName: BILLING_PREVIOUS_MONTH_WiTH_NOTES
        label: PREVIOUS MONTH WITH NOTES
        layout {
            sequence: 60
            region: @billing
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: triggerAction
        }
        advanced {
            customAttributes: target="_blank"
