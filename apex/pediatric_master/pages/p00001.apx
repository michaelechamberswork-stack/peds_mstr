page 1 (
    name: Home
    title: Home
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region billing (
        name: BILLING
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
    )

    region billing-2 (
        name: BILLING
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @selector
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region billing-report (
        name: BILLING REPORT
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                     case_number,
                     case_number_assigned,
                     client,
                     session_month,
                     therapist,
                     print_link
                FROM (
                        SELECT
                            case_number, 
                            case_number_assigned, b.last_name || ', ' || b.first_name client, 
                            TRUNC(date_session, 'MONTH') session_month, 
                            t.last_name || ', ' || t.first_name therapist,
                            NULL print_link
                        FROM case_folder_billing b 
                            LEFT JOIN therapists t ON b.therapist_id = t.id
                        WHERE s_id IN (
                                        SELECT MAX(s_id)
                                        FROM case_folder_billing
                                        GROUP BY case_number, TRUNC(date_session, 'MONTH')
                                       )
                    )
                ORDER BY session_month DESC, therapist, client
                ```
        }
        layout {
            sequence: 40
            parentRegion: @billing-2
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CASE_NUMBER (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column CASE_NUMBER_ASSIGNED (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column CLIENT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: CLIENT
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column PRINT_LINK (
            reportColumnQueryId: 6
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: &REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/invoice.rpt&prompt1=#CASE_NUMBER#&prompt2=#SESSION_MONTH#&prompt3=A
                }
                linkText: <span class="fa fa-print" aria-hidden="true"></span>
                linkAttributes: target="_blank"
            }
            sorting {
                sortable: false
            }
        )

        column SESSION_MONTH (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: MONTH
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column THERAPIST (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: THERAPIST
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    region billing-search (
        name: BILLING SEARCH
        type: smartFilters
        source {
            filteredRegion: @billing-report
        }
        layout {
            sequence: 10
            parentRegion: @billing-2
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P1_SEARCH_BILLING (
            type: search
            label {
                label: Search Billing
            }
            layout {
                sequence: 10
            }
        )

    )

