    region sessions-to-be-reviewed-report (
        name: SESSIONS TO BE REVIEWED REPORT
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                    s_id,
                    therapist_id,
                    first_name||' '||last_name client,
                    date_session,
                    time_length,
                    CASE WHEN late_reason IS NOT NULL THEN
                        '<a href="'||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:1303:&APP_SESSION.::NO:RP,1303:P1303_S_ID:'||s_id)||'"><span aria-hidden="true" class="fa fa-clock-o fam-warning fam-is-danger"></span></a>'
                    ELSE
                        NULL
                    END late,
                    NULL edit_link,
                    NULL print_link
                FROM case_folder
                WHERE status = 'S'
                ```
        }
        layout {
            sequence: 30
            parentRegion: @sessions-to-be-reviewed
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CLIENT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: CLIENT
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column DATE_SESSION (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: SESSION
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column EDIT_LINK (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            link {
                target: {
                    page: 1301
                    items: {
                        P1301_S_ID: #S_ID#
                        FROM_PAGE: 1
                        P1301_REVIEW: N
                    }
                    clearCache: 1301
                }
                linkText: <span aria-hidden="true" class="fa fa-pencil"></span>
            }
        )

        column LATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: LATE
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT *
                    FROM case_folder
                    WHERE status = 'S'
                        AND late_reason IS NOT NULL
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PRINT_LINK (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: &REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/session.rpt&prompt1=0&prompt2=#S_ID#&prompt3=N&prompt4=1/1/1900&prompt5=1/1/9999
                }
                linkText: <span class="fa fa-print" aria-hidden="true"></span>
                linkAttributes: target="_blank"
            }
        )

        column S_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 1301
                    items: {
                        P1301_S_ID: #S_ID#
                        P1301_REVIEW: Y
                    }
                    clearCache: 1301
                    action: resetPagination
                }
                linkText: <span aria-hidden="true" class="fa fa-eye"></span>
            }
        )

        column THERAPIST_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: THERAPIST
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @therapists
            }
            layout {
                sequence: 3
            }
        )

        column TIME_LENGTH (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: LENGTH
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @session-length
            }
            layout {
                sequence: 5
            }
        )

    )

    region sessions-to-be-reviewed-search (
