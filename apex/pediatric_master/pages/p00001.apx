            }
            execution {
                sequence: 10
            }
        )

    )

    button print-current-month-billing (
        buttonName: PRINT_CURRENT_MONTH_BILLING
        label: PRINT CURRENT MONTH BILLING
        layout {
            sequence: 20
            region: @billing-report
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            icon: fa-print
        }
        behavior {
            action: triggerAction
        }
        advanced {
            customAttributes: target="_blank"
        }
        serverSideCondition {
            type: never
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.open("&REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/invoice.rpt&prompt1=-1&prompt2=&P1_CURRENT_MONTH.&prompt3=A");
            }
            execution {
                sequence: 10
            }
        )

    )

    button print-previous-month-billing (
        buttonName: PRINT_PREVIOUS_MONTH_BILLING
        label: PRINT PREVIOUS MONTH BILLING
        layout {
            sequence: 40
            region: @billing-report
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            icon: fa-print
        }
        behavior {
            action: triggerAction
        }
        advanced {
            customAttributes: target="_blank"
        }
        serverSideCondition {
            type: never
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.open("&REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/invoice.rpt&prompt1=-1&prompt2=&P1_PREVIOUS_MONTH.&prompt3=A")
            }
            execution {
                sequence: 10
            }
        )

