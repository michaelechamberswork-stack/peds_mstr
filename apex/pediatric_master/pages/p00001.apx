    button test (
        buttonName: TEST
        label: Test
        layout {
            sequence: 10
            region: @billing-report
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            icon: fa-print
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @billing
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-app-mode (
        name: Set App Mode
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P1_MODE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :APP_MODE := :P1_MODE;
                itemsToSubmit: P1_MODE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

