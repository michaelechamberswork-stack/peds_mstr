    region sessions-reviewed-report (
        name: SESSIONS REVIEWED REPORT
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                    s_id,
                    therapist_id,
                    first_name||' '||last_name client,
                    session_start date_session,
                    time_length,
                    NULL edit_link,
                    NULL print_link,
                    TRUNC(session_start, 'MONTH') sdate,
                    LAST_DAY(session_start) edate,
                    NULL print_month
                FROM case_folder
                WHERE status = 'R'
                ```
        }
        layout {
            sequence: 20
            parentRegion: @sessions-reviewed
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CLIENT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: CLIENT
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column DATE_SESSION (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: SESSION
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: MM/DD/YYYY HH:MI AM
            }
        )

        column EDATE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column EDIT_LINK (
            reportColumnQueryId: 6
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            link {
                target: {
                    page: 1301
                    items: {
                        P1301_S_ID: #S_ID#
                        FROM_PAGE: 1
                        P1301_REVIEW: N
                    }
                    clearCache: 1301
                }
                linkText: <span aria-hidden="true" class="fa fa-pencil"></span>
            }
        )

        column PRINT_LINK (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: &REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/session.rpt&prompt1=0&prompt2=#S_ID#&prompt3=N&prompt4=1/1/1900&prompt5=1/1/9999
                }
                linkText: <span class="fa fa-print" aria-hidden="true"></span>
                linkAttributes: target="_blank"
            }
        )

        column PRINT_MONTH (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: MONTH
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: &REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/session.rpt&prompt1=0&prompt2=0&prompt3=M&prompt4=#SDATE#&prompt5=#EDATE#
                }
                linkText: <span class="fa fa-print" aria-hidden="true"></span>
                linkAttributes: target="_blank"
            }
        )

        column SDATE (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 9
            }
        )

        column S_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column THERAPIST_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: THERAPIST
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @therapists
            }
            layout {
                sequence: 4
            }
        )

        column TIME_LENGTH (
