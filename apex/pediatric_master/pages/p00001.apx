    pageItem P1_CURRENT_MONTH (
        type: hidden
        layout {
            sequence: 10
            region: @billing-report
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: TO_CHAR(et_sysdate, 'MM/DD/YY')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1_MODE (
        type: radioGroup
        label {
            label: Mode
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @app-mode
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @home
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        serverSideCondition {
            type: expression
            plsqlExpression: lts_settings.is_app_admin
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1_PREVIOUS_MONTH (
        type: hidden
        layout {
            sequence: 20
            region: @billing-report
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: TO_CHAR(ADD_MONTHS(et_sysdate, -1), 'MM/DD/YY')
        }
        security {
            encryptSessionState: false
        }
    )

    button billing-current-month (
        buttonName: BILLING_CURRENT_MONTH
        label: "CURRENT MONTH "
        layout {
            sequence: 10
            region: @billing
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: triggerAction
        }
        advanced {
            customAttributes: target="_blank"
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.open("&REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/invoice.rpt&prompt1=-1&prompt2=&P1_CURRENT_MONTH.&prompt3=A");
            }
            execution {
                sequence: 10
            }
        )

    )

    button billing-current-month-with-notes (
        buttonName: BILLING_CURRENT_MONTH_WITH_NOTES
        label: CURRENT MONTH  WITH NOTES
        layout {
            sequence: 50
            region: @billing
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
