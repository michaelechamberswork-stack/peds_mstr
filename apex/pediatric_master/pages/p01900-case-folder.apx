page 1900 (
    name: Case Folder
    alias: CASE-FOLDER
    title: Case Folder
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .a-IRR-headerLink{
                text-transform: uppercase;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region case-folder (
        name: Case Folder
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CASE_NUMBER,
                       CASE_NUMBER_ASSIGNED,
                       FIRST_NAME,
                       LAST_NAME,
                       DOB,
                       DATE_START,
                       DATE_END,
                       ACTIVE,
                       THERAPIST_ID,
                       PARENT_1_FIRST_NAME,
                       PARENT_1_LAST_NAME,
                       PARENT_2_FIRST_NAME,
                       PARENT_2_LAST_NAME,
                       ADDRESS_LINE_1,
                       ADDRESS_LINE_2,
                       CITY,
                       STATE,
                       ZIP,
                       PHONE_1,
                       PHONE_2,
                       CASE_MANAGER,
                       O_ID,
                       OBJECTIVE,
                       START_DATE,
                       END_DATE,
                       S_ID,
                       SESSION_START,
                       DATE_SESSION,
                       TIME_START,
                       TIME_END,
                       TIME_LENGTH,
                       LOCATION,
                       ACTIVITY,
                       ACTIVITY ACTIVITY_TYPE,
                       LOCATION_OTHER,
                       ACTIVITY_OTHER,
                       COMMENTS,
                       STATUS,
                       LATE_REASON,
                       N_ID,
                       INTERVENTION,
                       PROGRESS,
                       NOTE_OBJECTIVE,
                       CANCEL_REASON,
                       SIGNATURE_THERAPIST_ID
                  from CASE_FOLDER
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 66321935452209261
        }

