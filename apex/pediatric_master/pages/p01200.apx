page 1200 (
    name: SESSIONS
    title: SESSIONS
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region sessions (
        name: SESSIONS
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                col-sm-12
                col-md-10
                col-lg-8
            ]
        }
        settings {
            outputAs: text
        }
    )

    region sessions-report (
        name: SESSIONS_REPORT
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select S_ID,
                       CASE_NUMBER,
                       DATE_SESSION,
                       TIME_START,
                       TIME_END,
                       TIME_LENGTH,
                       LOCATION,
                       ACTIVITY,
                       STATUS,
                       CASE WHEN STATUS = 'R' THEN
                           'Y'
                       ELSE
                           :READ_ONLY_ACCESS
                       END READ_ONLY,
                       NULL PRINT_LINK,
                       NULL PRINT_LINK_DEV
                  from SESSIONS
                  where case_number = :CURRENT_CLIENT
                ```
        }
        layout {
            sequence: 20
            parentRegion: @sessions
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ACTIVITY (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Activity
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @activity
            }
            layout {
                sequence: 81
            }
        )

        column CASE_NUMBER (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 21
            }
        )

        column DATE_SESSION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Date Session
                alignment: center
            }
            layout {
                sequence: 31
            }
        )

        column LOCATION (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Location
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @location
            }
            layout {
                sequence: 71
            }
        )

        column PRINT_LINK (
            reportColumnQueryId: 11
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 101
            }
            link {
                target: {
                    type: url
                    url: &REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/session.rpt&prompt1=0&prompt2=#S_ID#&prompt3=N&prompt4=1/1/1900&prompt5=1/1/9999
                }
                linkText: <img src="#IMAGE_PREFIX#menu/printer_64.gif" alt="" height="20px" width="20px">
                linkAttributes: target="_blank"
            }
        )

        column PRINT_LINK_DEV (
            reportColumnQueryId: 12
            derivedColumn: N
            type: link
            heading {
                heading: NEW PRINT LINK
                alignment: center
            }
            layout {
                sequence: 111
            }
            link {
                target: {
                    type: url
                    url: &REPORT_URL./pdfreport.aspx?&DEV.report=peds_mstr/session_dev.rpt&prompt1=0&prompt2=#S_ID#&prompt3=N&prompt4=1/1/1900&prompt5=1/1/9999
                }
                linkText: <img src="#IMAGE_PREFIX#menu/printer_64.gif" alt="" height="20px" width="20px">
                linkAttributes: target="_blank"
            }
            serverSideCondition {
                type: item=value
                item: APP_MODE
                value: A
            }
        )

        column READ_ONLY (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 121
            }
        )

        column STATUS (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Status
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @status
            }
            layout {
                sequence: 91
            }
        )

        column S_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 1201
                    items: {
                        P1201_S_ID: #S_ID#
                        P1201_READ_ONLY: #READ_ONLY#
                    }
                    clearCache: 1201
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                defaultSequence: 1
            }
        )

        column TIME_END (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Time End
                alignment: center
            }
            layout {
                sequence: 51
            }
            appearance {
                formatMask: HH:MI AM
            }
        )

        column TIME_LENGTH (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Time Length
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @session-length
            }
            layout {
                sequence: 61
            }
        )

        column TIME_START (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Time Start
                alignment: center
            }
            layout {
                sequence: 41
            }
            appearance {
                formatMask: HH:MI AM
            }
        )

    )

    region sessions-search (
        name: SESSIONS_SEARCH
        type: smartFilters
        source {
            filteredRegion: @sessions-report
        }
        layout {
            sequence: 10
            parentRegion: @sessions
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: SESSIONS_SEARCH
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P1200_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
        )

    )

    button new (
        buttonName: NEW
        label: ADD SESSION
        layout {
            sequence: 60
            region: @sessions-search
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1203
                items: {
                    P1203_CASE_NUMBER: &CURRENT_CLIENT.
                }
                clearCache: 1203
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: ADD_SESSION
            customAttributes: style="display: none;"
        }
        serverSideCondition {
            type: item!=value
            item: READ_ONLY_ACCESS
            value: Y
        }
    )

    dynamicAction move-and-trigger-show-hide-buttons (
        name: Move and Trigger Show/Hide Buttons
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#ADD_SESSION").insertAfter("#SESSIONS_SEARCH_fr_search");
                    $("#ADD_SESSION").show();
                    //$("#HIDE_INACTIVE").insertAfter("#SELECT_CLIENT_SEARCH_fr_search");
                    //$("#SHOW_INACTIVE").insertAfter("#SELECT_CLIENT_SEARCH_fr_search");
                    //$('#P1200_SELECT_CLIENT_SHOW_INACTIVE').trigger('change');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

