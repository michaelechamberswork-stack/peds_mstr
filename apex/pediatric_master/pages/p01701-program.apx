page 1701 (
    name: PROGRAM
    alias: PROGRAM
    title: PROGRAM
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region colors (
        name: COLORS
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with color_numbers as (
                    select rownum color_number
                    from all_objects
                    where rownum <= 45
                )
                select 
                    'u-color-'||rownum card_title,
                    'u-color-'||rownum card_color
                from color_numbers
                order by color_number
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: style="display: none;"
        }
        componentAppearance {
            gridColumns: 5
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: CARD_TITLE
        }
        pagination {
            type: page
            showTotalCount: true
            cardsPerPage: 100
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: onclick="apex.event.trigger(document, 'daSetColor', '&CARD_COLOR!ATTR.');"
            }
        )

    )

    region program (
        name: PROGRAM
        type: form
        source {
            location: localDatabase
            tableName: PROGRAMS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P1701_ACCT_NUM (
        type: textField
        label {
            label: ACCOUNT #
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @program
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 25
        }
        source {
            formRegion: @program
            column: ACCT_NUM
            dataType: varchar2
        }
    )

