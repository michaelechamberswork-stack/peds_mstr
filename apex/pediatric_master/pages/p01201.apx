    button add-objective (
        buttonName: ADD_OBJECTIVE
        label: ADD OBJECTIVE
        layout {
            sequence: 10
            region: @notes
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1101
                items: {
                    P1101_CASE_NUMBER: &CURRENT_CLIENT.
                    FROM_PAGE: &APP_PAGE_ID.
                }
                clearCache: 1101
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :READ_ONLY_ACCESS != 'Y'
                AND :P1201_READ_ONLY != 'Y'
                ```
        }
    )

