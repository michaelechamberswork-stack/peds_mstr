    dynamicAction disable-copy (
        name: Disable Copy
        execution {
            sequence: 110
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :READ_ONLY_ACCESS = 'Y'
                OR :P1201_READ_ONLY = 'Y'
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).bind("contextmenu cut copy",function(e){
                        e.preventDefault();
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction remove-reviewed-from-status (
        name: Remove Reviewed from Status
        execution {
            sequence: 100
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: item=value
            item: APP_MODE
            value: T
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "$(\"#P1201_STATUS option[value|='R']\").remove();"
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction session-cancelled (
        name: Session Cancelled
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: P1201_ACTIVITY
        }
        clientSideCondition {
            type: item=value
            item: P1201_ACTIVITY
            value: 10
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P1201_TIME_START
                    P1201_TIME_END
                    P1201_TIME_LENGTH
                    P1201_LOCATION
                    P1201_LOCATION_OTHER
                    P1201_ACTIVITY_OTHER
