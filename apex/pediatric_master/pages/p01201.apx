    dynamicAction calculate-time-length (
        name: Calculate Time Length
        execution {
            sequence: 140
        }
        when {
            selectionType: items
            items: [
                P1201_TIME_START
                P1201_TIME_END
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P1201_TIME_LENGTH").prop("disabled", false);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: $("#P1201_TIME_LENGTH").prop("disabled", true);
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vNum NUMBER;
                    BEGIN
                        IF :P1201_TIME_START IS NULL OR :P1201_TIME_END IS NULL THEN
                            RETURN NULL;
                        ELSE
                            /*Minutes*/
                            vNum := (TO_DATE(:P1201_TIME_END, 'HH:MI AM') - TO_DATE(:P1201_TIME_START, 'HH:MI AM')) * 24 * 60;
                            
                            IF MOD(vNum, 15) = 0 THEN
                                vNum := (vNum / 15) - 1;
                            ELSE
                                vNum := vNum / 15;
                            END IF;
                            
                            RETURN TRUNC(vNum);
                        END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P1201_TIME_START
                    P1201_TIME_END
                ]
            }
            affectedElements {
                selectionType: items
                items: P1201_TIME_LENGTH
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-close (
