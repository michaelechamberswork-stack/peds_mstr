    button delete (
        buttonName: DELETE
        label: DELETE
        layout {
            sequence: 50
            region: @session
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :APP_MODE = 'A'
                AND :P1201_S_ID IS NOT NULL
                ```
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: del.session(:P1201_S_ID);
                itemsToSubmit: P1201_S_ID
            }
            execution {
                sequence: 20
            }
        )

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.navigation.redirect(apex.util.makeApplicationUrl({
                        appId: $v('pFlowId'),
                        pageId: 1200,
                        session: $v('pInstance')
                    }));
                    
                    ```
            }
            execution {
                sequence: 30
            }
        )

        triggerAction plugin-be-ctb-alertify (
            action: plugin/alertify
            settings {
                dialogType: confirm
                message: Do you want to delete this session?
            }
            execution {
                sequence: 10
            }
        )

    )

