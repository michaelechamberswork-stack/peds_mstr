        source {
            formRegion: @session
            column: PSC_ID
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT min(psc_id)
                FROM program_service_codes psc
                    INNER JOIN programs p ON psc.psc_p_id = p.p_id
                    INNER JOIN clients c ON p.p_id = c.p_id
                WHERE c.case_number = :CURRENT_CLIENT
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

