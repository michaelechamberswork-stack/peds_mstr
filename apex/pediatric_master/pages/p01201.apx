page 1201 (
    name: SESSION
    title: SESSION
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline:
            ```css
            .textarea {
                width: 100%;
            }
            ```
    }
    readOnly {
        type: expression
        plsqlExpression:
            ```plsql
            :READ_ONLY_ACCESS = 'Y'
            OR :P1201_READ_ONLY = 'Y'
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    help {
        helpText: No help is available for this page.
    }

    region notes (
        name: NOTES
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT n_id, o_id, intervention, progress, objective
                FROM notes
                WHERE s_id = :P1201_S_ID
                ORDER BY o_id
                ```
            pageItemsToSubmit: P1201_S_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                col-sm-12
                col-md-10
                col-lg-8
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1201_S_ID
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: No Data Found
        }

        column INTERVENTION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: INTERVENTION
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column N_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 1202
                    items: {
                        P1202_N_ID: #N_ID#
                        P1202_READ_ONLY: &P1201_READ_ONLY.
                    }
                    clearCache: 1202
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column OBJECTIVE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: OBJECTIVE
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column O_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column PROGRESS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: PROGRESS
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

    )

