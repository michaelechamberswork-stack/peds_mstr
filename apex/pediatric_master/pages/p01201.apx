            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P1201_CANCEL_REASON
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: region
                region: @notes
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P1201_LOCATION").trigger("change");
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P1201_CANCEL_REASON
            }
            execution {
                sequence: 30
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P1201_TIME_START
                    P1201_TIME_END
                    P1201_TIME_LENGTH
                    P1201_LOCATION
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show-3 (
