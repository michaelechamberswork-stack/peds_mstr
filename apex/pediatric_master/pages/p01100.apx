page 1100 (
    name: OBJECTIVES
    title: OBJECTIVES
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region objectives (
        name: OBJECTIVES
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    o_id,
                    objective,
                    case_number,
                    start_date,
                    end_date
                FROM objectives
                WHERE case_number = :CURRENT_CLIENT
                    AND UPPER(NVL(objective, 'LTS_NULL')) LIKE '%'||UPPER(:P1100_REPORT_SEARCH)||'%'
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                col-sm-12
                col-md-10
                col-lg-8
            ]
        }
        reportLayout {
            numberOfRowsType: itemValue
            item: P1100_ROWS
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }

        column CASE_NUMBER (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column END_DATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: END
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column OBJECTIVE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: OBJECTIVE
                alignment: center
            }
            layout {
                sequence: 2
            }
            columnFormatting {
                highlightWords: &P1002_REPORT_SEARCH.
            }
        )

        column O_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 1101
                    items: {
                        P1101_O_ID: #O_ID#
                        FROM_PAGE: 1100
                    }
                    clearCache: [
                        1003
                        1101
                    ]
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                defaultSequence: 1
            }
        )

        column START_DATE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: START
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

    )

    region search (
        name: SEARCH
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                col-sm-12
                col-md-10
                col-lg-8
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P1100_REPORT_SEARCH (
        type: textField
        label {
            label: SEARCH
            alignment: left
        }
        settings {
            trimSpaces: none
            submitWhenEnterPressed: true
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 2000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1100_ROWS (
        type: selectList
        label {
            label: DISPLAY
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @report-rows-per-page
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: 15
        }
        default {
            type: static
            staticValue: 15
        }
        security {
            encryptSessionState: false
        }
    )

    button add-objective (
        buttonName: ADD_OBJECTIVE
        label: ADD OBJECTIVE
        layout {
            sequence: 50
            region: @search
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @text-w-null-label-above
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1101
                items: {
                    P1101_CASE_NUMBER: &CURRENT_CLIENT.
                    FROM_PAGE: 1100
                }
                clearCache: 1101
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: READ_ONLY_ACCESS
            value: Y
        }
    )

    button reset (
        buttonName: RESET
        label: RESET
        layout {
            sequence: 40
            region: @search
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @text-w-null-label-above
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button search (
        buttonName: SEARCH
        label: SEARCH
        layout {
            sequence: 30
            region: @search
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-w-null-label-above
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process reset-pagination (
        name: Reset Pagination
        type: resetPagination
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5841643743855560
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GO,P1100_REPORT_SEARCH,RESET
        }
    )

    process reset-report-search (
        name: Reset report search
        type: clearSessionState
        clear {
            type: items
            items: [
                P1100_REPORT_SEARCH
                P1100_ROWS
            ]
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 5842009442855561
        }
        serverSideCondition {
            whenButtonPressed: @reset
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1100
                successMessage: false
            }
        }
    )

)

