page 1501 (
    name: ASSESSMENT v2016
    alias: ASSESSMENT
    title: ASSESSMENT v2016
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    readOnly {
        type: always
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region assessment (
        name: ASSESSMENT
        type: form
        source {
            location: localDatabase
            tableName: ASSESSMENT
        }
        layout {
            sequence: 20
            parentRegion: @selector
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

