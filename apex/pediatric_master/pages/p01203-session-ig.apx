    dynamicAction validations-enable-time-length-and-set-checkbox (
        name: Validations, Enable Time Length, and Set Checkbox
        execution {
            sequence: 110
        }
        when {
            event: apexbeforepagesubmit
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function callError(item, message) {
                        apex.message.showErrors([
                            {
                                type: "error",
                                location: [ "page", "inline" ],
                                pageItem: item,
                                message: message,
                                unsafe: false
                            }
                        ]);
                        apex.event.gCancelFlag = true;
                    }
                    
                    var status = $v("P&APP_PAGE_ID._STATUS");
                    var activty = $v("P&APP_PAGE_ID._ACTIVITY");
                    var cancelReason = $v("P&APP_PAGE_ID._CANCEL_REASON");
                    var comments = $v("P&APP_PAGE_ID._COMMENTS");
                    var dateSession = $v("P&APP_PAGE_ID._DATE_SESSION");
                    var timeStart = $v("P&APP_PAGE_ID._TIME_START");
                    var timeEnd = $v("P&APP_PAGE_ID._TIME_END");
                    
                    apex.message.clearErrors();
                    
                    if( status == "S" ) {
                        if ( dateSession == "" ) {
                            callError( "P&APP_PAGE_ID._DATE_SESSION", "DATE is required when STATUS is Submitted" );
                        }
                        if ( timeStart == "" ) {
                            callError( "P&APP_PAGE_ID._TIME_START", "START is required when STATUS is Submitted" );
                        }
                        if ( timeEnd == "" ) {
                            callError( "P&APP_PAGE_ID._TIME_END", "END is required when STATUS is Submitted" );
                        }
                        if( activty == "10" ) {
                            if ( cancelReason == "" ) {
                                callError( "P&APP_PAGE_ID._CANCEL_REASON", "CANCEL REASON is required when ACTIVITY is Session Cancelled" );
                            }
                            else if ( cancelReason == "10" && comments == "" ) {
                                callError( "P&APP_PAGE_ID._COMMENTS", "COMMENTS is required when CANCEL REASON is other" );
                            }
                        }
                    }
                    
                    if ( !apex.event.gCancelFlag ) {
                        $("#P&APP_PAGE_ID._TIME_LENGTH").prop("disabled", false);
                    
                        // set checkboxes not checked to N and type hidden
                        $('input[type="checkbox"][name^="f0"]:not(:checked)').each(function() {
                            // Change its value to 'N'
                            $(this).val('N');
                            // Set the 'checked' property to true
                            $(this).prop('type', 'hidden');
                        });
                    }
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process check-for-late-documentation (
        name: Check for Late Documentation
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update sessions
                set status = 'D'
                where s_id = :P1203_S_ID;
                
                apex_application.g_request := 'LATE';
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 26823653988608604
        }
        serverSideCondition {
            type: expression
            plsqlExpression: documentation_late(:P1203_S_ID) AND :P1203_STATUS = 'S' AND :P1203_LATE_REASON IS NULL
        }
    )

    process create-note-entries (
        name: Create Note Entries
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    vDate DATE;
                    vCaseNumber NUMBER;
                BEGIN
                    SELECT date_session, case_number
                    INTO vDate, vCaseNumber
                    FROM sessions
                    WHERE s_id = :P1203_S_ID;
                
                    INSERT INTO notes(s_id, o_id, objective)
                    SELECT :P1203_S_ID, o_id, objective
                    FROM objectives
                    WHERE vDate BETWEEN NVL(start_date, vDate - 1) AND NVL(end_date, vDate + 1)
                        AND case_number = vCaseNumber
                        AND o_id NOT IN
                        (
                            SELECT o_id
                            FROM notes
                            WHERE s_id = :P1203_S_ID
                        );
                
                    COMMIT;
                END;
                ```
        }
        execution {
            sequence: 30
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 175521195087010930
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1203_S_ID
        }
    )

    process create-session (
        name: Create Session
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    insert into sessions(case_number, therapist_id, date_session)
                    values(:P1203_CASE_NUMBER, :APP_USER_ID, et_sysdate)
                    return s_id into :P1203_S_ID;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 156725175403652031
        }
        serverSideCondition {
            type: itemIsNull
            item: P1203_S_ID
        }
    )

