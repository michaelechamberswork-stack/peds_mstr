    region notes-ig (
        name: NOTES_IG
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select N_ID,
                       O_ID,
                       INTERVENTION,
                       PROGRESS,
                       S_ID,
                        CASE 
                            WHEN LENGTH(OBJECTIVE) <= 40 THEN OBJECTIVE
                            WHEN INSTR(SUBSTR(OBJECTIVE, 1, 40), ' ', -1) > 0 THEN
                            SUBSTR(OBJECTIVE, 1, INSTR(SUBSTR(OBJECTIVE, 1, 40), ' ', -1) - 1) || '...'
                        ELSE 
                            SUBSTR(OBJECTIVE, 1, 40) || '...'
                        END OBJECTIVE,
                       OBJECTIVE FULL_OBJECTIVE,
                       LAST_SAVED_BY_LEVEL,
                       CREATED_BY,
                       CREATED_ON,
                       UPDATED_BY,
                       UPDATED_ON,
                       ROW_VERSION,
                       OBJECTIVE_WORKED_ON,
                       OBJECTIVE_MET
                  from NOTES
                 where s_id = :P1203_S_ID
                ```
            pageItemsToSubmit: P1203_S_ID
        }
        layout {
            sequence: 20
            parentRegion: @session
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: NOTES_IG
        }
