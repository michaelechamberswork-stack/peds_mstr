    button apply-changes (
        buttonName: APPLY_CHANGES
        label: APPLY
        layout {
            sequence: 30
            region: @session
            slot: change
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P1203_S_ID IS NOT NULL
                AND :READ_ONLY_ACCESS != 'Y'
                AND :P1203_READ_ONLY != 'Y'
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: CANCEL
        layout {
            sequence: 40
            region: @session
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1200
                clearCache: 1203
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: OK
        layout {
            sequence: 10
            region: @session
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P1203_S_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: DELETE
        layout {
            sequence: 50
            region: @session
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P1203_S_ID IS NOT NULL AND (:P1203_STATUS = 'D' OR :APP_MODE = 'A')
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: del.session(:P1203_S_ID);
                itemsToSubmit: P1203_S_ID
            }
            execution {
                sequence: 20
            }
        )

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.navigation.redirect(apex.util.makeApplicationUrl({
