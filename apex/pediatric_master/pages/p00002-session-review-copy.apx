page 2 (
    name: Session Review Copy
    alias: SESSION-REVIEW-COPY
    title: Session Review Copy
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function setCanvasSize()
            {   
                // maximum variables
            	var mw = 500; 	// maximum width
            	var mh = 250; 	// maximum height
            	var ph = 0.5; 	// percentage height to width
            	var pw = 2; 	// percentage width to height
            	
            	// object variables
            	var $c = $("#CREATE_SIG_signature_canvas");                                 // canvas object
                var $d = $("#CREATE_SIG_signature");                                        // canvas div object
            	var $w = $(window); 						                                // window object
            	var $b = $("#SIG_SAVE");					                                // save button object
            
            	// variables
            	var h = $(".t-Header-branding").height();			                        // header height
            	var dtb = $b.offset().top + $b.height() - $c.offset().top - $c.height(); 	// distance between canvas and save button
            	var innerHeightSpace = $w.height() - ( h + dtb );		                    // height available within screen
            	
            	// let's see if we're in portrait or landscape
            	if( $w.width() > $w.height() )
                {
                    // landscape
            		// let's determine the height with a maximum height of mh
            		if( $w.height() - h - dtb < mh )
            		{
                        resizeCanvas( ($w.height() - h - dtb) * pw, $w.height() - h - dtb )
            		}
            		else
            		{
                        resizeCanvas( mw, mh );
            		}
                    
                    // scroll to the canvas
                    $("html, body").animate({ scrollTop: $c.offset().top - h - 10 }, 0);
                }
            	else
            	{
                    // portrait
            		// let's determine the width with a maximum width of mw
            		if( $w.width() - ( $c.offset().left * 2 ) < mw )
            		{
                        resizeCanvas( $w.width() - ( $c.offset().left * 2 ), ( $w.width() - ( $c.offset().left * 2 ) ) * ph );
            		}
            		else
            		{
                        resizeCanvas( mw, mh );
            		}
            	}
                
                // let's make sure the canvas div is large enough
                if( $c.width() > $d.width() )
                    $(".div-expand").attr( "class", "div-expand" );
            }
            
            function resizeCanvas( newWidth, newHeight )
            {
                // get source canvas
                var srcCanvas = document.getElementById("CREATE_SIG_signature_canvas");
            
                // duplicate source to a temp canvas
                var tmpCanvas = document.createElement("canvas");
                tmpCanvas.width = newWidth;
                tmpCanvas.height = newHeight;
            
                var tmpCtx = tmpCanvas.getContext('2d');
                
                // draw the source canvas onto the temp canvas at the new size
                tmpCtx.drawImage( srcCanvas, 0, 0, newWidth, newHeight );
                
                // resize source canvas
                srcCanvas.width = newWidth;
                srcCanvas.height = newHeight;
                
                // draw tmp canvas back to source canvas
                var srcCtx = srcCanvas.getContext('2d');
                srcCtx.drawImage( tmpCanvas, 0, 0 ); 
            }
            
            function setCanvasBackgroundWhite()
            {
                // get source canvas
                var srcCanvas = document.getElementById("CREATE_SIG_signature_canvas");
            
                // create a temp canvas
                var tmpCanvas = document.createElement("canvas");
                tmpCanvas.width = srcCanvas.width;
                tmpCanvas.height = srcCanvas.height;
            
                var tmpCtx = tmpCanvas.getContext('2d');
            
                // create a rectangle with the desired color
                tmpCtx.fillStyle = "#FFFFFF";
                tmpCtx.fillRect( 0, 0, srcCanvas.width, srcCanvas.height );
            
                // draw the source canvas onto the tmp canvas
                tmpCtx.drawImage( srcCanvas, 0, 0 );
            
                // draw tmp canvas back to source canvas
                srcCtx = srcCanvas.getContext('2d');
                srcCtx.drawImage( tmpCanvas, 0, 0 );    
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region create-signature (
        name: Create Signature
        type: plugin/apexSignature
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: CREATE_SIG
        }
        settings {
            width: 500
            height: 250
            penColor: black
            plsqlCode:
                ```plsql
                DECLARE
                    l_clob CLOB;
                    l_blob BLOB;
                    l_filename VARCHAR2(100);
                    l_token VARCHAR2(32000);
                BEGIN
                    -- build CLOB from f01 30k Array
                    dbms_lob.createtemporary(l_clob,
                                           FALSE,
                                           dbms_lob.session);
                
                    FOR i IN 1 .. apex_application.g_f01.count LOOP
                        l_token := wwv_flow.g_f01(i);
                  
                        IF length(l_token) > 0 THEN
                            dbms_lob.writeappend(
                                l_clob,
                                length(l_token),
                                l_token);
                        END IF;
                    END LOOP;
                  --
                  -- convert base64 CLOB to BLOB (mimetype: image/png)
                  l_blob := apex_web_service.clobbase642blob(p_clob => l_clob);
                  --
                  -- create own collection (here starts custom part (for example a Insert statement))
                  UPDATE session_review
                  SET reviewer_signature = l_blob,
                      reviewer_date = et_sysdate
                  WHERE case_number = :CURRENT_CLIENT
                      AND sr_date = :P2_REPORT_MONTH;      
                END;
                ```
            clearButtonJquerySelector: #SIG_CLEAR
            saveButtonJquerySelector: #SIG_SAVE
            showWaitspinner: true
            logging: false
        }
    )

    region view-signature (
        name: View Signature
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    sr_id,
                    reviewer_date,
                    NVL2(reviewer_signature, 'YES', 'NO') has_signature,
                    NULL del_signature
                FROM
                    session_review
                WHERE
                    case_number = :CURRENT_CLIENT
                    AND sr_date = TO_DATE(:P2_REPORT_MONTH, 'MM/DD/YYYY')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: VIEW_SIG
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DEL_SIGNATURE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: link
            heading {
                heading: Del Signature
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    type: url
                    url: javascript: apex.event.trigger(document, 'DeleteSignature', #SR_ID#);
                }
                linkText: <img src="#IMAGE_PREFIX#alert_error.gif" class="apex-edit-view" alt="">
            }
        )

        column HAS_SIGNATURE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column REVIEWER_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Reviewer Date
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column SR_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: displayImage
            heading {
                heading: Sr Id
                alignment: center
            }
            layout {
                sequence: 3
            }
            blobAttributes {
                tableName: SESSION_REVIEW
                blobColumn: REVIEWER_SIGNATURE
                primaryKeyColumn1: SR_ID
            }
        )

    )

