    dynamicAction select-report-month (
        name: Select Report Month
        execution {
            sequence: 10
        }
        when {
            event: custom
            customEvent: ReportMonthSelected
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT sr_id
                    INTO :SR_ID
                    FROM session_review
                    WHERE sr_date = :P2_REPORT_MONTH
                        AND case_number = :CURRENT_CLIENT;
                    ```
                itemsToSubmit: CURRENT_CLIENT
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @view-signature
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
