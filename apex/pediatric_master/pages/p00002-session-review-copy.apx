    dynamicAction delete-signature (
        name: Delete Signature
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: DeleteSignature
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: remove_reviewer_signature;
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @view-signature
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.data;
            }
            affectedElements {
                selectionType: items
                items: P2_DEL_SIGNATURE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-be-ctb-alertify (
            action: plugin/alertify
            settings {
                dialogType: confirm
                message: Remove signature?
            }
            execution {
