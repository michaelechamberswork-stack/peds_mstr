    dynamicAction view-signature-refreshed (
        name: View Signature Refreshed
        execution {
            sequence: 40
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @view-signature
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "setTimeout(function(){setCanvasSize()}, 50);"
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#VIEW_SIG").hide();
                    $("#CREATE_SIG").hide();
                    
                    console.log($("td[headers='HAS_SIGNATURE']").html());
                    
                    if($("td[headers='HAS_SIGNATURE']").html() == "YES")
                        $("#VIEW_SIG").show();
                    else
                        $("#CREATE_SIG").show();
                    
                    $("table[summary='View Signature']").find("thead").hide();
                    $("td[headers='HAS_SIGNATURE']").hide();
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process create-session-review-entries (
        name: Create Session Review Entries
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                INSERT INTO session_review(sr_date, case_number)
                SELECT DISTINCT TRUNC(date_session, 'MM'), case_number
                FROM sessions
                WHERE case_number = :CURRENT_CLIENT
                    AND TRUNC(date_session, 'MM') NOT IN
                    (
                        SELECT sr_date
                        FROM session_review
                        WHERE case_number = :CURRENT_CLIENT
                    );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9951832896995017
        }
    )

)

