page 1601 (
    name: drop down entry
    alias: DROP-DOWN-ENTRY
    title: drop down entry
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region drop-down-entry (
        name: drop down entry
        type: form
        source {
            location: localDatabase
            tableName: DROP_DOWN_TYPE_ENTRY
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P1601_CREATED_BY (
        type: displayOnly
        label {
            label: Created By
            alignment: left
        }
        layout {
            sequence: 70
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @drop-down-entry
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P1601_CREATED_ON (
        type: displayOnly
        label {
            label: Created On
            alignment: left
        }
        layout {
            sequence: 80
            region: @drop-down-entry
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 4
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @drop-down-entry
            column: CREATED_ON
            dataType: date
        }
    )

    pageItem P1601_DROP_DOWN_TYPE_ENTRY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @drop-down-entry
            slot: regionBody
        }
        source {
            formRegion: @drop-down-entry
            column: DROP_DOWN_TYPE_ENTRY_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1601_DROP_DOWN_TYPE_ID (
        type: popupLov
        label {
            label: Drop Down Type Id
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @drop-down-type-type-name
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @drop-down-entry
            column: DROP_DOWN_TYPE_ID
            dataType: number
        }
    )

    pageItem P1601_ENTRY (
        type: textField
        label {
            label: Entry
            alignment: left
        }
        layout {
            sequence: 30
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
        source {
            formRegion: @drop-down-entry
            column: ENTRY
            dataType: varchar2
        }
    )

    pageItem P1601_EXTRA (
        type: textField
        label {
            label: Extra
            alignment: left
        }
        layout {
            sequence: 60
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @drop-down-entry
            column: EXTRA
            dataType: varchar2
        }
    )

    pageItem P1601_ORDER_BY (
        type: numberField
        label {
            label: Order By
            alignment: left
        }
        layout {
            sequence: 50
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @drop-down-entry
            column: ORDER_BY
            dataType: number
        }
    )

    pageItem P1601_ROW_VERSION (
        type: displayOnly
        label {
            label: Row Version
            alignment: left
        }
        layout {
            sequence: 110
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @drop-down-entry
            column: ROW_VERSION
            dataType: number
        }
    )

    pageItem P1601_UPDATED_BY (
        type: displayOnly
        label {
            label: Updated By
            alignment: left
        }
        layout {
            sequence: 90
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @drop-down-entry
            column: UPDATED_BY
            dataType: varchar2
        }
    )

    pageItem P1601_UPDATED_ON (
        type: displayOnly
        label {
            label: Updated On
            alignment: left
        }
        layout {
            sequence: 100
            region: @drop-down-entry
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 4
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @drop-down-entry
            column: UPDATED_ON
            dataType: date
        }
    )

    pageItem P1601_VALUE (
        type: textField
        label {
            label: Value
            alignment: left
        }
        layout {
            sequence: 40
            region: @drop-down-entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        source {
            formRegion: @drop-down-entry
            column: VALUE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P1601_DROP_DOWN_TYPE_ENTRY_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1601_DROP_DOWN_TYPE_ENTRY_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1601_DROP_DOWN_TYPE_ENTRY_ID
        }
    )

    dynamicAction set-text-fields (
        name: set text fields 100%
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("input[type='text']:not([id*='_DATE_'])").each(function() {
                        $(this).parent().css('width', '100%');
                        $(this).css('width', '100%');
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 118334668979712662
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-drop-down-entry (
        name: Initialize form drop down entry
        type: formInitialization
        formRegion: @drop-down-entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 118333837929712661
        }
    )

    process process-form-drop-down-entry (
        name: Process form drop down entry
        type: formAutoRowProcessing
        formRegion: @drop-down-entry
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 118334299089712662
        }
    )

)

