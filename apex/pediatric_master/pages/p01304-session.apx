            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    UPDATE sessions
                    SET status = 'R'
                    WHERE s_id = :P1304_S_ID;
                    ```
                itemsToSubmit: P1304_S_ID
            }
            execution {
