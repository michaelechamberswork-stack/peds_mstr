            }
        )

    )

    button save (
        buttonName: SAVE
        label: OK
        layout {
            sequence: 40
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P1304_S_ID IS NOT NULL
                AND
                :P1304_REVIEW != 'Y'
                ```
        }
    )

    dynamicAction calculate-time-length (
        name: Calculate Time Length
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: [
                P1304_TIME_END
                P1304_TIME_START
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P1304_TIME_LENGTH").prop("disabled", false);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: $("#P1304_TIME_LENGTH").prop("disabled", true);
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vNum NUMBER;
                    BEGIN
                        IF :P1304_TIME_START IS NULL OR :P1304_TIME_END IS NULL THEN
                            RETURN NULL;
                        ELSE
                            /*Minutes*/
                            vNum := (TO_DATE(:P1304_TIME_END, 'HH:MI AM') - TO_DATE(:P1304_TIME_START, 'HH:MI AM')) * 24 * 60;
                            
                            IF MOD(vNum, 15) = 0 THEN
                                vNum := (vNum / 15) - 1;
                            ELSE
                                vNum := vNum / 15;
                            END IF;
                            
                            RETURN TRUNC(vNum);
                        END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P1304_TIME_START
                    P1304_TIME_END
                ]
            }
            affectedElements {
                selectionType: items
                items: P1304_TIME_LENGTH
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

