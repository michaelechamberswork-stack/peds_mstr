    button cancel (
        buttonName: CANCEL
        label: CANCEL
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: DELETE
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vNum NUMBER;
                BEGIN
                
                    IF :P1304_S_ID IS NULL OR :APP_MODE = 'T' OR :P1304_REVIEW = 'Y' THEN
                        RETURN FALSE;
                    END IF;
                
                    SELECT COUNT(*)
                    INTO vNum
                    FROM notes
                    WHERE s_id = :P1304_S_ID;
                    
                    RETURN vNum = 0;
                END;
                ```
        }

        triggerAction native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
            }
        )

        triggerAction plugin-be-ctb-alertify (
            action: plugin/alertify
            settings {
                dialogType: confirm
                message: Do you want to delete this session?
            }
            execution {
                sequence: 10
            }
        )

    )

    button reviewed (
        buttonName: REVIEWED
        label: REVIEWED
        layout {
