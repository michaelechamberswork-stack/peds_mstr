    region notes (
        name: NOTES
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT n_id, o_id, intervention, objective, objective_met--, objective_worked_on
                FROM notes
                WHERE s_id = :P1304_S_ID
                    and (objective_worked_on = 'Y' or intervention is not null)
                ORDER BY o_id
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1304_S_ID
        }
        config {
            buildOption: @excluded
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: No Data Found
        }

        column INTERVENTION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: INTERVENTION
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column N_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 1302
                    items: {
                        P1302_N_ID: #N_ID#
                    }
                    clearCache: 1302
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: item!=value
                item: P1304_REVIEW
                value: Y
            }
