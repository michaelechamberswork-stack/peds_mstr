                sortable: false
            }
        )

        column O_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

    )

    region notes-2 (
        name: NOTES
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    n_id, 
                    o_id, 
                    intervention, 
                    CASE 
                        WHEN LENGTH(OBJECTIVE) <= 40 THEN OBJECTIVE
                        WHEN INSTR(SUBSTR(OBJECTIVE, 1, 40), ' ', -1) > 0 THEN
                            SUBSTR(OBJECTIVE, 1, INSTR(SUBSTR(OBJECTIVE, 1, 40), ' ', -1) - 1) || '...'
                        ELSE 
                            SUBSTR(OBJECTIVE, 1, 40) || '...'
                        END OBJECTIVE,
                    objective_met, 
                    objective full_objective
                FROM notes
                WHERE s_id = :P1304_S_ID
                    and (objective_worked_on = 'Y' or intervention is not null)
                ORDER BY o_id
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1304_S_ID
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: No Data Found
        }

        column FULL_OBJECTIVE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 25
            }
        )

