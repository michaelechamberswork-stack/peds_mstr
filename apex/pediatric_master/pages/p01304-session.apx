    dynamicAction validations-and-enable-time-length (
        name: Validations and Enable Time Length
        execution {
            sequence: 150
        }
        when {
            event: apexbeforepagesubmit
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function callError(item, message) {
                        apex.message.showErrors([
                            {
                                type: "error",
                                location: [ "page", "inline" ],
                                pageItem: item,
                                message: message,
                                unsafe: false
                            }
                        ]);
                        apex.event.gCancelFlag = true;
                    }
                    
                    var status = $v("P&APP_PAGE_ID._STATUS");
                    var activty = $v("P&APP_PAGE_ID._ACTIVITY");
                    var location = $v("P&APP_PAGE_ID._LOCATION");
                    var cancelReason = $v("P&APP_PAGE_ID._CANCEL_REASON");
                    var comments = $v("P&APP_PAGE_ID._COMMENTS");
                    var dateSession = $v("P&APP_PAGE_ID._DATE_SESSION");
                    var timeStart = $v("P&APP_PAGE_ID._TIME_START");
                    var timeEnd = $v("P&APP_PAGE_ID._TIME_END");
                    
                    apex.message.clearErrors();
                    
                    if( status == "S" && $v("P&APP_PAGE_ID._READ_ONLY") != "Y") {
                        if ( activty == "" ) {
                            callError( "P&APP_PAGE_ID._ACTIVITY", "ACTIVITY is required when STATUS is Submitted" );
                        }
                        if ( location == "" ) {
                            callError( "P&APP_PAGE_ID._LOCATION", "LOCATION is required when STATUS is Submitted" );
                        }
                        if( activty != "10" ) {
                            if ( dateSession == "" ) {
                                callError( "P&APP_PAGE_ID._DATE_SESSION", "DATE is required when STATUS is Submitted" );
                            }
                            if ( timeStart == "" ) {
                                callError( "P&APP_PAGE_ID._TIME_START", "START is required when STATUS is Submitted" );
                            }
                            if ( timeEnd == "" ) {
                                callError( "P&APP_PAGE_ID._TIME_END", "END is required when STATUS is Submitted" );
                            }
                        }
                        else if( activty == "10" ) {
                            if ( cancelReason == "" ) {
                                callError( "P&APP_PAGE_ID._CANCEL_REASON", "CANCEL REASON is required when ACTIVITY is Session Cancelled" );
                            }
                            else if ( cancelReason == "10" && comments == "" ) {
                                callError( "P&APP_PAGE_ID._COMMENTS", "COMMENTS is required when CANCEL REASON is other" );
                            }
                        }
                        if ( activty == "2" && $v("P&APP_PAGE_ID._ACTIVITY_OTHER") == "" ) {
                            callError( "P&APP_PAGE_ID._ACTIVITY_OTHER", "CONSULTED WITH is required when ACTIVITY is Other" );
                        }
                        if ( Number($v("P&APP_PAGE_ID._LOCATION")) > 1 && $v("P&APP_PAGE_ID._LOCATION_OTHER") == "" ) {
                            callError( "P&APP_PAGE_ID._LOCATION_OTHER", "SERVICE LOCATION is required when LOCATION is Other" );
                        }
                        if ( $("#P&APP_PAGE_ID._LATE_REASON_CONTAINER").is(":visible") && $v("P&APP_PAGE_ID._LATE_REASON") == "" ) {
                            callError( "P&APP_PAGE_ID._LATE_REASON", "REASON DOCUMENTING IS LATE is required" );
                        }
                    }
                    
                    if ( !apex.event.gCancelFlag ) {
                        $("#P&APP_PAGE_ID._TIME_LENGTH").prop("disabled", false);
                    
                        // set checkboxes not checked to N and type hidden
                        $('input[type="checkbox"][name^="f0"]:not(:checked)').each(function() {
                            // Change its value to 'N'
                            $(this).val('N');
                            // Set the 'checked' property to true
                            $(this).prop('type', 'hidden');
                        });
                    }
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation end-must-be-after-start (
        name: End Must be After Start
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P1304_TIME_START IS NULL OR :P1304_TIME_END IS NULL THEN
                    RETURN TRUE;
                ELSIF TO_DATE(:P1304_TIME_END, 'HH:MI AM') <= TO_DATE(:P1304_TIME_START, 'HH:MI AM') THEN
                    RETURN FALSE;
                ELSE
                    RETURN TRUE;
                END IF;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: End Time must be after Start Time
        }
    )

    process create-note-entries (
        name: Create Note Entries
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    vDate DATE;
                    vCaseNumber NUMBER;
                BEGIN
                    SELECT date_session, case_number
                    INTO vDate, vCaseNumber
                    FROM sessions
                    WHERE s_id = :P1304_S_ID;
                
                    INSERT INTO notes(s_id, o_id, objective)
                    SELECT :P1304_S_ID, o_id, objective
                    FROM objectives
                    WHERE vDate BETWEEN NVL(start_date, vDate - 1) AND NVL(end_date, vDate + 1)
                        AND case_number = vCaseNumber
                        AND o_id NOT IN
                        (
                            SELECT o_id
                            FROM notes
                            WHERE s_id = :P1304_S_ID
                        );
                
                    COMMIT;
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 191139145543572856
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1304_S_ID
        }
    )

