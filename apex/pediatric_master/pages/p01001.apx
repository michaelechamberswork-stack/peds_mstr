    button cancel-create (
        buttonName: CANCEL_CREATE
        label: CANCEL
        layout {
            sequence: 10
            region: @client
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1000
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: CURRENT_CLIENT
        }
    )

    button cancel-save (
        buttonName: CANCEL_SAVE
        label: CANCEL
        layout {
            sequence: 20
            region: @client
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1001
                items: {
                    P1001_CASE_NUMBER: &P1001_CASE_NUMBER.
                }
                clearCache: 1001
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNullAndNotZero
            item: CURRENT_CLIENT
        }
    )

    button create (
        buttonName: CREATE
        label: APPLY
        layout {
            sequence: 40
            region: @client
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P1001_CASE_NUMBER
        }
    )

    button save (
        buttonName: SAVE
        label: APPLY
        layout {
            sequence: 30
            region: @client
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P1001_CASE_NUMBER IS NOT NULL
                AND :READ_ONLY_ACCESS != 'Y'
                ```
        }
    )

    process fetch-row-from-clients (
        name: Fetch Row from CLIENTS
        type: autoRowFetch
        source {
            tableName: CLIENTS
            pkColumn: CASE_NUMBER
            pkItem: CURRENT_CLIENT
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5675290387394982
        }
    )

    process process-row-of-clients (
        name: Process Row of CLIENTS
        type: autoRowProcessing
        target {
            tableName: CLIENTS
            pkColumn: CASE_NUMBER
            pkItem: P1001_CASE_NUMBER
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 5675680845394982
        }
    )

    branch (
        name: Go To Page 1001
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1001
                items: {
                    P1001_CASE_NUMBER: &P1001_CASE_NUMBER.
                }
                clearCache: 1001
            }
        }
    )

)

