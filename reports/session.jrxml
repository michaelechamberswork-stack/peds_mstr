<jasperReport name="session_note" language="java" pageWidth="612" pageHeight="792" whenNoDataType="NoDataSection" columnWidth="540" leftMargin="36" rightMargin="36" topMargin="36" bottomMargin="36" uuid="529dd2e1-2974-4548-b1c6-7cecdf7b0dc1">
	<property name="net.sf.jasperreports.data.adapter" value="LTS"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LTS"/>
	<style name="Base" default="true" fontName="SansSerif" fontSize="10.0"/>
	<style name="Label" style="Base" bold="true"/>
	<style name="Title" style="Base" hTextAlign="Center" fontSize="14.0" bold="true"/>
	<style name="RowShade" mode="Transparent">
		<conditionalStyle mode="Opaque" backcolor="#C0C0C0">
			<conditionExpression><![CDATA[$F{ROW_SEQ} != null && $F{ROW_SEQ}.intValue() % 2 == 1]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="review" class="java.lang.String"/>
	<parameter name="s_id" class="java.lang.String"/>
	<parameter name="case_number" class="java.lang.String"/>
	<parameter name="StartDate" class="java.lang.String"/>
	<parameter name="EndDate" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT cf.S_ID,
       cf.CASE_NUMBER,
       cf.CASE_NUMBER_ASSIGNED,
       cf.FIRST_NAME || ' ' || cf.LAST_NAME                       AS PED_NAME,
       TO_CHAR(cf.DATE_SESSION, 'FMMM/DD/YYYY')
         || '  ' || TO_CHAR(cf.TIME_START, 'FMHH:FMMI AM')
         || ' to ' || TO_CHAR(cf.TIME_END, 'FMHH:FMMI AM')         AS SESSION_DATE_LINE,
       TRIM(loc.LOCATION_DISPLAY
         || NVL2(cf.LOCATION_OTHER, ' - ' || cf.LOCATION_OTHER, NULL)) AS LOCATION_TEXT,
       TRIM(act.ACTIVITY_DISPLAY
         || NVL2(cf.ACTIVITY_OTHER, ' - ' || cf.ACTIVITY_OTHER, NULL)) AS ACTIVITY_TEXT,
       peds_mstr.get_time_length_display(cf.TIME_LENGTH)          AS TIME_LENGTH_DISPLAY,
       cf.COMMENTS,
       cf.NOTE_OBJECTIVE,
       cf.INTERVENTION,
       cf.PROGRESS,
       cf.NARRATIVE,
       cf.SESSION_START,
       TRIM(t.FIRST_NAME || ' ' || t.LAST_NAME || ' ' || t.TITLE) AS THERAPIST_LINE,
       t.SIGNATURE_BLOB,
       CASE WHEN cf.PROGRESS IS NULL AND cf.INTERVENTION IS NULL THEN NULL
            ELSE ROW_NUMBER() OVER (
                   PARTITION BY cf.S_ID,
                                CASE WHEN cf.PROGRESS IS NULL AND cf.INTERVENTION IS NULL THEN 0 ELSE 1 END
                   ORDER BY cf.S_ID)
       END                                                         AS ROW_SEQ,
       CASE
         WHEN NVL(TO_NUMBER($P{case_number}), 0) > 0
           THEN 'SESSION' || CHR(10) || cf.FIRST_NAME || ' ' || cf.LAST_NAME
         WHEN NVL(TO_NUMBER($P{s_id}), 0) > 0 AND $P{review} = 'Y'
           THEN 'SESSION REVIEW' || CHR(10) || cf.FIRST_NAME || ' ' || cf.LAST_NAME
                || ' ' || TO_CHAR(cf.DATE_SESSION, 'FMMM/DD/YYYY')
         WHEN NVL(TO_NUMBER($P{s_id}), 0) > 0
           THEN 'SESSION' || CHR(10) || cf.FIRST_NAME || ' ' || cf.LAST_NAME
                || ' ' || TO_CHAR(cf.DATE_SESSION, 'FMMM/DD/YYYY')
         WHEN $P{review} = 'M'
           THEN 'REVIEWED SESSIONS' || CHR(10) || $P{StartDate} || ' to ' || $P{EndDate}
         ELSE 'SESSION REVIEW'
       END                                                         AS REPORT_TITLE
  FROM PEDS_MSTR.CASE_FOLDER cf
  LEFT JOIN PEDS_MSTR.ACTIVITY act ON cf.ACTIVITY = act.ACTIVTY_ID
  LEFT JOIN PEDS_MSTR.LOCATION loc ON cf.LOCATION = loc.LOCATION_ID
  JOIN LTS.THERAPISTS t            ON cf.SIGNATURE_THERAPIST_ID = t.ID
 WHERE (
        ($P{review} = 'Y' AND cf.STATUS = 'S')
     OR ($P{review} = 'M' AND cf.STATUS = 'R'
         AND cf.SESSION_START >= TO_DATE($P{StartDate}, 'YYYY-MM-DD')
         AND cf.SESSION_START <  TO_DATE($P{EndDate},   'YYYY-MM-DD') + 1)
     OR (NVL($P{review}, '~') NOT IN ('Y', 'M')
         AND NVL(TO_NUMBER($P{s_id}), 0) > 0
         AND cf.S_ID = TO_NUMBER($P{s_id}))
     OR (NVL($P{review}, '~') NOT IN ('Y', 'M')
         AND NVL(TO_NUMBER($P{s_id}), 0) <= 0
         AND NVL(TO_NUMBER($P{case_number}), 0) > 0
         AND $P{review} = 'P'
         AND cf.CASE_NUMBER = TO_NUMBER($P{case_number})
         AND cf.SESSION_START >= TO_DATE($P{StartDate}, 'YYYY-MM-DD')
         AND cf.SESSION_START <  TO_DATE($P{EndDate},   'YYYY-MM-DD') + 1)
     OR (NVL($P{review}, '~') NOT IN ('Y', 'M', 'P')
         AND NVL(TO_NUMBER($P{s_id}), 0) <= 0
         AND NVL(TO_NUMBER($P{case_number}), 0) > 0
         AND cf.CASE_NUMBER = TO_NUMBER($P{case_number}))
       )
 ORDER BY cf.S_ID, ROW_SEQ]]></query>
	<field name="S_ID" class="java.math.BigDecimal"/>
	<field name="CASE_NUMBER" class="java.lang.String"/>
	<field name="CASE_NUMBER_ASSIGNED" class="java.lang.String"/>
	<field name="PED_NAME" class="java.lang.String"/>
	<field name="SESSION_DATE_LINE" class="java.lang.String"/>
	<field name="LOCATION_TEXT" class="java.lang.String"/>
