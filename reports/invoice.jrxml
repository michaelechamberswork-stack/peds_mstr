	<parameter name="p_case_number" class="java.lang.String"/>
	<parameter name="p_session_month" class="java.lang.String"/>
	<parameter name="p_mode" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT case_folder."CASE_NUMBER",
	case_folder."SESSION_START",
	therapists."FIRST_NAME",
	therapists."LAST_NAME",
	therapists."TITLE",
	case_folder."DATE_SESSION",
	case_folder."TIME_START",
	case_folder."TIME_END",
	case_folder."FIRST_NAME",
	case_folder."LAST_NAME",
	case_folder.last_name || ', ' || case_folder.first_name "PED_NAME",
	case_folder."CASE_NUMBER_ASSIGNED",
	case_folder."S_ID",
	case_folder."PROG_COST_NUM",
	case_folder."PROG_ACCT_NUM",
	case_folder."SERVICE_DESCRIPTION",
	case_folder."SERVICE_CODE",
	case_folder."SERVICE_CHARGE",
	case_folder."PROG_NAME",
	case_folder."PROG_ADDRESS1",
	case_folder."PROG_ADDRESS2",
	case_folder."PROG_CITY",
	case_folder."PROG_STATE",
	case_folder."PROG_ZIP",
	case_folder."REVIEWER_DATE",
	activity."ACTIVTY_ID",
	activity."ACTIVITY_DISPLAY",
	case_folder."COMMENTS",
	cancel_reason."CANCEL_REASON_DISPLAY",
	cancel_reason."CANCEL_REASON_ID",
	activity."ACTIVITY_TYPE",
	therapists."SIGNATURE_BLOB",
	case_folder."REVIEWER_SIGNATURE",
	case_folder."DATE_SESSION_MONTH"
FROM "PEDS_MSTR"."CASE_FOLDER_BILLING" case_folder
	left outer join "PEDS_MSTR"."ACTIVITY" activity ON 
	 case_folder."ACTIVITY" = activity."ACTIVTY_ID" 
	inner join "LTS"."THERAPISTS" therapists ON 
	 case_folder."THERAPIST_ID" = therapists."ID" 
	left outer join "PEDS_MSTR"."CANCEL_REASON" cancel_reason ON 
	 case_folder."CANCEL_REASON" = cancel_reason."CANCEL_REASON_ID"
WHERE ($P{p_case_number} =  case_folder."CASE_NUMBER" or $P{p_case_number} = '-1')
and case_folder."DATE_SESSION_MONTH" = TRUNC(TO_DATE($P{p_session_month}, 'mm/dd/yyyy'), 'month')
and activity."ACTIVITY_TYPE" = 'Direct'
ORDER BY case_folder."PROG_NAME", case_folder."LAST_NAME", case_folder."FIRST_NAME", case_folder."DATE_SESSION"]]></query>
